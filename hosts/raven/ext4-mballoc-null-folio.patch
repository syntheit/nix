 /*
+ * The 6.1.y backport of "ext4: convert bd_{bitmap,buddy}_page to folio"
+ * assumes the 6.4+ __filemap_get_folio(), which returns ERR_PTR() on a
+ * cache miss or failed allocation. 6.1's returns NULL, so a buddy-cache
+ * page evicted under memory pressure dereferences NULL in
+ * ext4_mb_load_buddy_gfp(). Restore the semantics the code expects.
+ */
+static inline struct folio *ext4_mb_get_folio(struct address_space *mapping,
+		pgoff_t index, int fgp_flags, gfp_t gfp)
+{
+	struct folio *folio = __filemap_get_folio(mapping, index, fgp_flags, gfp);
+
+	return folio ?: ERR_PTR(-ENOMEM);
+}
