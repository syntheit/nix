+            and stripped[2:].islower()):
+            # Shift-lag typo ("WHat" -> "What"): EXACTLY two leading capitals
+            # with an all-lowercase tail means the OSK auto-caps level
+            # dropped one key too late -- never an intentional casing
+            # (iPhone/McD have capitals after a lowercase run and are still
+            # protected by the mixed-caps guard below). Case-only fix, always
+            # safe; must run BEFORE that guard, and still honors the
+            # anti-force window: a re-typed word means the user wants it.
+            low = stripped.lower()
+            self._osk_np_expire_recent_corrections()
+            if self._osk_np_is_revert(low, stripped):
+                return None
+            return stripped[0] + stripped[1].lower() + stripped[2:]
+        if any(char.isupper() for char in stripped[1:]):
+            return None  # iPhone, McD..., ALLCAPS: intentional
+        low = stripped.lower()
+        self._osk_np_expire_recent_corrections()
+        if self._osk_np_is_revert(low, stripped):
+            return None
+        if self.database.hunspell_obj.spellcheck(stripped):
+            # Dictionary-valid word: never distance-correct it, but allow
+            # PURE ACCENT RECOVERY (mas -> más) when the accented variant
+            # overwhelmingly dominates in the user db (seeded with real
+            # corpus frequencies). The 10x ratio gate keeps ambiguous pairs
+            # (esta/está 7:1, si/sí, solo/sólo) untouched, and the length
+            # gate keeps the pronoun pairs (si/tu/el/mi) out entirely.
+            # Re-typing after an unwanted fix force-learns the plain form,
+            # shifting the ratio until the pair locks out (self-correcting).
+            if len(stripped) < 3:
+                return None
+            deaccented_low = itb_util_core.remove_accents(low)
+            best_variant = ''
+            best_freq = 0
+            for dictionary in self.database.hunspell_obj._dictionaries:  # pylint: disable=protected-access
+                for variant in dictionary.spellcheck_suggest(stripped)[:8]:
+                    variant = itb_util_core.strip_token(variant)
+                    if not variant or variant.lower() == low:
+                        continue
+                    if itb_util_core.remove_accents(
+                            variant.lower()) != deaccented_low:
+                        continue
+                    variant_freq = self.database.phrase_exists(
+                        variant.lower())
+                    if variant_freq > best_freq:
+                        best_variant = variant
+                        best_freq = variant_freq
+            typed_freq = self.database.phrase_exists(stripped)
+            if best_variant and best_freq >= 10 * max(1, typed_freq):
+                if stripped[0].isupper() and not best_variant[0].isupper():
+                    best_variant = best_variant[0].upper() + best_variant[1:]
+                return best_variant
+            return None
+        if self.database.phrase_exists(stripped) >= 3:
+            # genuinely learned by the user (or force-learned on re-type);
+            # low-frequency strays (corpus-seed noise like "teh") don't count
+            return None
+        # Correction source: real spell suggestions from each active
+        # dictionary (needs a pyhunspell/enchant backend — the engine's
+        # _candidates are completion-oriented and often miss corrections).
+        # Interleave en/es so neither language starves the other.
+        deaccented_typed = itb_util_core.remove_accents(low)
+        active_lang = self._osk_np_active_language()
+        per_dict = [(dictionary.name.split('_')[0],
+                     dictionary.spellcheck_suggest(stripped))
+                    for dictionary
+                    in self.database.hunspell_obj._dictionaries]  # pylint: disable=protected-access
+        suggestions = []
+        suggestion_langs: Dict[str, set] = {}
+        for tier in itertools.zip_longest(
+                *[tier_suggestions for (_lang, tier_suggestions) in per_dict]):
+            for lang_index, phrase in enumerate(tier):
+                if phrase is None:
+                    continue
+                if phrase not in suggestion_langs:
+                    suggestion_langs[phrase] = set()
+                    suggestions.append(phrase)
+                suggestion_langs[phrase].add(per_dict[lang_index][0])
+        scored = []
+        for raw_phrase in suggestions[:8]:
+            langs = suggestion_langs[raw_phrase]
+            lang_penalty = (0 if not active_lang or active_lang in langs
+                            else 1)
+            phrase = itb_util_core.strip_token(raw_phrase)
+            if not phrase or phrase == stripped:
+                continue  # identity; case-variants (i'm -> I'm) stay in
+            if any(char.isdigit() for char in phrase):
+                continue
+            if ' ' in phrase or '-' in phrase:
+                continue  # no multi-word/hyphen splits from one word
+            deaccented_phrase = itb_util_core.remove_accents(phrase.lower())
+            if deaccented_phrase == deaccented_typed:
+                distance = 0  # pure accent/case fix — always closest
+            else:
+                if not deaccented_phrase or not deaccented_typed:
+                    continue
+                if deaccented_phrase[0] != deaccented_typed[0]:
+                    continue
+                cap = 1 if len(stripped) <= 4 else 2
+                distance = self._osk_np_edit_distance(
+                    deaccented_typed, deaccented_phrase, cap)
+                if distance > cap:
+                    continue
+            freq = self.database.phrase_exists(phrase.lower())
+            scored.append((distance, lang_penalty, -freq, phrase))
+        if not scored:
+            return None
+        # fajita fork: break distance+language ties by learned frequency
+        # (higher first, via -freq), so equidistant same-language candidates
+        # prefer the more-used word (holq -> hola, not hole). Sort is stable,
+        # so with no tie the pre-existing hunspell ordering is preserved.
+        scored.sort(key=lambda entry: (entry[0], entry[1], entry[2]))
+        phrase = scored[0][3]
+        if stripped[0].isupper() and not phrase[0].isupper():
+            phrase = phrase[0].upper() + phrase[1:]
+        return phrase
+
+    def _osk_np_clear_tap_coords(self) -> None:
+        """Clear the per-letter tap-coord buffer and any staged ROW/COL pair.
+        Call wherever _osk_np_word is cleared/sealed/reset."""
+        self._osk_np_tap_coords = []
+        self._osk_np_pending_qrow = None
+        self._osk_np_pending_qcol = None
+
+    def _osk_np_spatial_corrector(self) -> Any:
+        """Lazily build the spatial corrector; None if unavailable/disabled.
+        Any construction failure disables spatial for the session (logged once)
+        and falls back to the legacy corrector — never breaks typing."""
+        if self._osk_spatial_corrector is False:
+            return None
+        if self._osk_spatial_corrector is not None:
+            return self._osk_spatial_corrector
+        try:
+            self._osk_spatial_corrector = osk_spatial.SpatialCorrector(
+                self._osk_spatial_db_paths)
+        except Exception as error:  # pylint: disable=broad-except
+            LOGGER.exception(
+                'osk-spatial: corrector init failed (%s) — disabling spatial, '
+                'falling back to legacy autocorrect', error)
+            self._osk_spatial_corrector = False
+            return None
+        return self._osk_spatial_corrector
+
+    def _osk_np_boundary_correction(self, typed: str) -> Optional[str]:
+        """Choose the boundary correction for `typed`. Prefers the spatial
+        (touch-geometry) corrector when it is enabled, available, and EVERY
+        letter of the word carries a tap coord; otherwise falls back to the
+        legacy _osk_np_autocorrect_candidate. Returns the replacement word or
+        None. Never raises: any spatial failure degrades to the legacy path."""
+        if (self._osk_spatial_enabled
+                and self._osk_np_tap_coords
+                and len(self._osk_np_tap_coords) == len(typed)
+                and all(coord is not None
+                        for coord in self._osk_np_tap_coords)):
+            corrector = self._osk_np_spatial_corrector()
+            if corrector is not None:
+                try:
+                    prev_word = self.get_p_phrase() or None
+                    lang = self._osk_np_active_language() or 'en'
+                    best, _confidence, should = corrector.decide(
+                        typed, list(self._osk_np_tap_coords), prev_word, lang)
+                    if should and best and best != typed:
+                        return best
+                    # Spatial ran but declined (conservative): honor that and
+                    # do NOT fall through to the legacy corrector for this word
+                    # — the whole point of spatial is to be the decider when it
+                    # has coords. Returning None leaves the word untouched.
+                    return None
+                except Exception as error:  # pylint: disable=broad-except
+                    LOGGER.exception(
+                        'osk-spatial: decide() failed for %r (%s) — falling '
+                        'back to legacy autocorrect', typed, error)
+                    # fall through to legacy on error
+        return self._osk_np_autocorrect_candidate(typed)
+
+    def _osk_np_boundary(self, key: itb_util_core.KeyEvent, sep: str) -> bool:
+        """Handle a word-boundary character (space/punctuation)."""
+        self._osk_gesture_alternates = []  # word is being sealed
+        typed = self._osk_np_word
+        corrected = None
+        if (self._osk_autocorrect
+            and typed
+            and sep in self._OSK_NP_AUTOCORRECT_SEPARATORS):
+            corrected = self._osk_np_boundary_correction(typed)
+        if corrected:
+            before = self._osk_np_before_cursor()
+            lag_ok = (before is not None
+                      and typed.startswith(
+                          self._osk_np_trailing_word(before)))
+            if before is not None and (before.endswith(typed) or lag_ok):
+                self.delete_surrounding_text(-len(typed), len(typed))
+                super().commit_text(
+                    IBus.Text.new_from_string(corrected + sep))
+                self._osk_np_recent_corrections[typed.lower()] = (
+                    time.monotonic(), self.get_p_phrase())
+                self._record_in_database_and_push_context(
+                    commit_phrase=corrected, input_phrase=typed)
+                # fajita fork: arm the tappable "undo autocorrect" affordance.
+                # Remember exactly what we put in the app (corrected + sep) so
+                # the undo can delete precisely that and restore the original
+                # the user typed. Only on the branch that actually committed a
+                # correction — never on the safe-fallback below.
+                self._osk_np_revert_pending = {
+                    'original': typed, 'committed': corrected + sep}
+            else:
+                # surrounding text disagrees (lag or external edit): play safe
+                corrected = None
+        if not corrected:
+            super().commit_text(IBus.Text.new_from_string(sep))
+            if typed:
+                self._record_in_database_and_push_context(
+                    commit_phrase=typed, input_phrase=typed)
+            # no correction happened: nothing to undo
+            self._osk_np_revert_pending = None
+        self._commit_happened_after_focus_in = True
+        if typed:
+            self._osk_np_vote_language(corrected or typed)
+        self._osk_np_last_commit_time = time.monotonic()
+        self._osk_np_last_finished = (corrected or typed, time.monotonic())
+        self._osk_np_word = ''
+        self._osk_np_clear_tap_coords()
+        self._clear_input()
+        self._trigger_surrounding_text_update()
+        GLib.timeout_add(5, self._update_ui_empty_input_try_completion)
+        # surrounding text lags on real clients; retry once it has arrived
+        GLib.timeout_add(350, self._update_ui_empty_input_try_completion)
+        return True
+
+    def _osk_np_candidate_clicked(self) -> bool:
+        """Replace the committed word with the tapped candidate.
+        Returns True when handled."""
+        phrase = self.get_string_from_lookup_table_cursor_pos()
+        if not phrase:
+            return True
+        # fajita fork: tappable "undo autocorrect". If an autocorrect just
+        # fired we parked the ORIGINAL typed word at strip slot 0 (see
+        # _osk_np_inject_revert_candidate). A tap on that exact slot means
+        # "no, keep what I typed": restore it and teach the keyboard.
+        if (self._osk_autocorrect
+            and self._osk_np_revert_pending is not None
+            and self._lookup_table.get_cursor_pos() == 0
+            and phrase == self._osk_np_revert_pending['original']):
+            if self._osk_np_do_revert():
+                return True
+            # revert bailed (surrounding text disagreed): fall through and
+            # treat the tap as an ordinary candidate commit of the original.
+        typed = self._osk_np_word
+        if typed:
+            before = self._osk_np_before_cursor()
+            lag_ok = (before is not None
+                      and typed.startswith(
+                          self._osk_np_trailing_word(before)))
+            if before is None or not (before.endswith(typed) or lag_ok):
+                LOGGER.warning(
+                    'osk-np: surrounding text does not end with %r, '
+                    'not replacing', typed)
+                return True
+            self.delete_surrounding_text(-len(typed), len(typed))
+        commit = phrase + ' ' if self._add_space_on_commit else phrase
+        super().commit_text(IBus.Text.new_from_string(commit))
+        self._commit_happened_after_focus_in = True
+        self._osk_np_last_commit_time = time.monotonic()
+        self._record_in_database_and_push_context(
+            commit_phrase=phrase, input_phrase=typed or phrase)
+        self._osk_np_vote_language(phrase)
+        self._osk_np_last_finished = (phrase, time.monotonic())
+        self._osk_np_word = ''
+        self._osk_np_clear_tap_coords()
+        self._clear_input()
+        self._trigger_surrounding_text_update()
+        GLib.timeout_add(5, self._update_ui_empty_input_try_completion)
+        GLib.timeout_add(350, self._update_ui_empty_input_try_completion)
+        self._osk_gesture_alternates = []  # alternate picked or confirmed
+        return True
+
+    def _osk_np_do_revert(self) -> bool:
+        """fajita fork: undo the autocorrect recorded in
+        self._osk_np_revert_pending — restore the ORIGINAL typed word and
+        teach the keyboard never to correct it again (iOS/Android style).
+
+        Returns True when the undo was performed (or safely aborted, i.e.
+        handled), False only if the caller should instead treat the tap as an
+        ordinary candidate commit. Always clears the pending state."""
+        pending = self._osk_np_revert_pending
+        self._osk_np_revert_pending = None
+        if not pending:
+            return False
+        original = pending['original']
+        committed = pending['committed']
+        # Same surrounding-text safety guard the rest of the code uses: only
+        # touch the client when its view still ends with what we committed
+        # (correction + separator). If it lags or was edited externally, bail
+        # without deleting anything destructive.
+        before = self._osk_np_before_cursor()
+        if before is None or not before.endswith(committed):
+            LOGGER.warning(
+                'osk-np: surrounding text does not end with %r, '
+                'not reverting autocorrect', committed)
+            return True
+        # Restore the original word followed by the SAME separator the
+        # correction carried (the last char of `committed`): the user only
+        # rejected the spelling change, not the space/punctuation they typed.
+        sep = committed[len(committed) - 1:]
+        self.delete_surrounding_text(-len(committed), len(committed))
+        super().commit_text(IBus.Text.new_from_string(original + sep))
+        self._commit_happened_after_focus_in = True
+        self._osk_np_last_commit_time = time.monotonic()
+        # Force-learn the original so it survives future boundaries, and drop
+        # it from recent-corrections so the retype-revert path (_osk_np_is_revert)
+        # does not double-handle the same word.
+        self._osk_np_learn(original)
+        self._osk_np_recent_corrections.pop(original.lower(), None)
+        self._record_in_database_and_push_context(
+            commit_phrase=original, input_phrase=original)
+        self._osk_np_vote_language(original)
+        self._osk_np_last_finished = (original, time.monotonic())
+        self._osk_np_word = ''
+        self._osk_np_clear_tap_coords()
+        self._clear_input()
+        self._trigger_surrounding_text_update()
+        GLib.timeout_add(5, self._update_ui_empty_input_try_completion)
+        GLib.timeout_add(350, self._update_ui_empty_input_try_completion)
+        self._osk_gesture_alternates = []  # word replaced
+        return True
+
+    def _osk_np_process_key(self, key: itb_util_core.KeyEvent) -> Optional[bool]:
+        """No-preedit key handling. None = fall through to stock code."""
+        if self.get_current_imes()[0] != 'NoIME':
+            return None
+        if key.release:
+            if key.val in self._osk_np_consumed_vals:
+                self._osk_np_consumed_vals.discard(key.val)
+                return True
+            return None
+        if (key.control or key.mod1 or key.mod4
+            or key.super or key.hyper or key.meta):
+            return None
+        if key.val in (IBus.KEY_Return, IBus.KEY_KP_Enter, IBus.KEY_ISO_Enter,
+                       IBus.KEY_Tab, IBus.KEY_BackSpace, IBus.KEY_Delete,
+                       IBus.KEY_Escape, IBus.KEY_Left, IBus.KEY_Right,
+                       IBus.KEY_Up, IBus.KEY_Down):
+            return None
+        uchar = key.unicode
+        if not uchar or unicodedata.category(uchar[0]) in ('Cc', 'Cf'):
+            return None
+        # fajita fork: tap-coordinate markers (protocol v1) that precede a
+        # plain-tap letter are now absorbed at the very top of
+        # do_process_key_event (before compose/keymap), so they stash
+        # _osk_np_pending_qrow / _osk_np_pending_qcol and never reach here. The
+        # staged pair is attached to the next real letter appended to
+        # _osk_np_word below.
+        # fajita fork rev 10: intercept PUA gesture framing markers (cat=Co)
+        # and letters arriving mid-trace BEFORE any other handling.
+        # Also absorbs stray PUA in no-preedit mode regardless of gesture-enabled.
+        if (self._osk_gesture_enabled
+                or unicodedata.category(uchar[0]) == 'Co'
+                or self._osk_gesture_trace is not None):
+            try:
+                gesture_result = self._osk_gesture_process(key, uchar)
+            except Exception as err:  # pylint: disable=broad-except
+                LOGGER.exception(
+                    'osk-gesture: process error %s — dropping trace',
+                    err)
+                self._osk_gesture_trace = None
+                gesture_result = True  # absorb; never let PUA reach app
+            if gesture_result is not None:
+                if gesture_result:
+                    self._osk_np_consumed_vals.add(key.val)
+                return gesture_result
+        self._osk_np_resync_empty()
+        self._osk_np_check_sync()
+        if self._osk_np_is_word_char(uchar[0]):
+            if not self._osk_np_word:
+                self.get_context()
+                # fajita fork: a new word begins — the "undo autocorrect"
+                # affordance is only live for the word we just corrected
+                # (iOS behaviour), so retire it now.
+                self._osk_np_revert_pending = None
+            self._osk_gesture_alternates = []  # word extended by typing
+            super().commit_text(IBus.Text.new_from_string(uchar))
+            self._commit_happened_after_focus_in = True
+            self._osk_np_last_commit_time = time.monotonic()
+            self._osk_np_word += uchar
+            # fajita fork: attach this letter's tap coord (protocol v1). If a
+            # fresh ROW+COL pair was staged by the markers that preceded this
+            # key, convert 1/8-key quanta back to fractional (col,row); else
+            # append None (letter arrived without coords -> spatial disabled for
+            # this word). Reset the staging slots either way.
+            if (self._osk_np_pending_qrow is not None
+                    and self._osk_np_pending_qcol is not None):
+                self._osk_np_tap_coords.append(
+                    (self._osk_np_pending_qcol / self._OSK_TAP_COORD_SCALE,
+                     self._osk_np_pending_qrow / self._OSK_TAP_COORD_SCALE))
+            else:
+                self._osk_np_tap_coords.append(None)
+            self._osk_np_pending_qrow = None
+            self._osk_np_pending_qcol = None
+            self._insert_string_at_cursor(list(uchar))
+            self._trigger_surrounding_text_update()
+            self._update_ui()
+            self._osk_np_consumed_vals.add(key.val)
+            return True
+        self._osk_np_consumed_vals.add(key.val)
+        return self._osk_np_boundary(key, uchar)
+
+    # --- fajita fork: swipe-typing gesture decoder (rev 10) ----------------
+    #
+    # The shell (gnome-shell-mobile fork, Phase S) emits a SYMBOLIC trace via
+    # IBus press-only key events framed with PUA codepoints:
+    #   U+F8D0 (gesture start) … letters … U+F8D1 (gesture end)
+    #   U+F8D2 before an anchor (corner/dwell) letter
+    #   U+F8D4 immediately after start if shift was active
+    # The engine intercepts these in _osk_gesture_process(), decodes the
+    # trace against its first+last-key bucket index, commits the best word
+    # without a trailing space (keeps the word "open" as _osk_np_word so all
+    # subsequent actions reuse the shipped rev-9 no-preedit machinery),
+    # and fills the strip with top-3 alternates.
+    # See ~/fajita-notes/swipe-typing-plan.md §6–7 for full rationale.
+
+    # --- static helpers (importable without IBus bus for unit tests §7.4) ---
+
+    @staticmethod
+    def _osk_g_key_seq(word: str) -> str:
+        """Collapse a word to its canonical key sequence on the us-mobile layout.
+
+        Steps: NFD casefold → remove all accents (no keep set, matching the
+        ñ-less us-mobile layout where ñ→n, á→a etc.) → drop non a–z chars
+        (apostrophes: "don't"→"dont") → collapse consecutive duplicates
+        ("hello"→"helo"). Returns '' for words that degenerate to < 2 keys."""
+        # casefold first so ß → ss, Ü → ü etc.
+        casefolded = unicodedata.normalize('NFD', word.casefold())
+        # strip combining marks (= remove accents with no keep set)
+        stripped = ''.join(
+            c for c in casefolded
+            if unicodedata.category(c) != 'Mn')
+        # keep only a–z
+        only_az = ''.join(c for c in stripped if 'a' <= c <= 'z')
+        if not only_az:
+            return ''
+        # collapse consecutive duplicates
+        collapsed = only_az[0]
+        for c in only_az[1:]:
+            if c != collapsed[-1]:
+                collapsed += c
+        return collapsed if len(collapsed) >= 2 else ''
+
+    @staticmethod
+    def _osk_g_is_subsequence(ks: str, letters: str) -> bool:
+        """Return True iff ks is an ordered subsequence of letters.
+
+        Two-pointer greedy; allocation-free — hot inner loop of the decoder."""
+        ki = 0
+        n_ks = len(ks)
+        for lc in letters:
+            if lc == ks[ki]:
+                ki += 1
+                if ki == n_ks:
+                    return True
+        return False
+
+    @classmethod
+    def _osk_g_score(
+            cls,
+            ks: str,
+            word_nfd: str,
+            letters: str,
+            anchor_set: Set[str],
+            active_lang: str,
+            freq: float,
+            in_dict: bool,
+            word_langs: Set[str]) -> float:
+        """Score a candidate against the trace. Higher = better.
+
+        Weights retuned in the rev-10 review pass: the plan's starting
+        weights let raw user-frequency trump path structure ("ha"=211 beat
+        "hola"=3 on a clean h-o-l-a trace with every key anchored). Anchors
+        are the corners the finger deliberately turned on — a word that
+        skips one must be nearly dead no matter how frequent it is."""
+        s = 2.0 * math.log2(1.0 + freq)
+        if in_dict:
+            s += 1.5
+        if ks[0] == letters[0]:
+            s += 4.0
+        if ks[-1] == letters[-1]:
+            s += 2.0
+        # anchors in the trace that the key-seq doesn't explain: heavy.
+        # (soft, not a reject: on-glass corner detection may mark a key
+        # adjacent to the real turn — the true word must survive that.)
+        ks_set = set(ks)
+        unexplained = sum(1 for a in anchor_set if a not in ks_set)
+        s -= 6.0 * unexplained
+        # trace letters the word skips (a swipe crosses ≈ the word's keys;
+        # a short word inside a long trace is almost never what was meant)
+        s -= 0.5 * (len(letters) - len(ks))
+        # prefer word-length ≈ number of anchor marks (weak: long straight
+        # words legitimately produce few corners)
+        s -= 0.4 * abs(len(anchor_set) - len(ks))
+        # sink spurious short subsequences
+        s += 0.3 * len(ks)
+        # soft language gate: −3.0 if valid only in the OTHER language
+        if active_lang and word_langs and active_lang not in word_langs:
+            s -= 3.0
+        return s
+
+    # --- index build (runs in daemon thread at engine start) ----------------
+
+    def _osk_gesture_build_index(self) -> None:
+        """Build the first+last-key bucket index from dict wordlists + user.db.
+
+        Runs in a daemon background thread; assigns _osk_gesture_index atomically
+        (GIL dict swap). Measured ~684 ms on fajita; harmless if retried."""
+        import sqlite3 as _sqlite3
+        import time as _time
+        try:
+            t0 = _time.monotonic()
+            # --- Step 1: populate _OSK_G_NEIGHBORS if not done yet ----------
+            if not TypingBoosterEngine._OSK_G_NEIGHBORS:
+                TypingBoosterEngine._OSK_G_NEIGHBORS = (
+                    TypingBoosterEngine._osk_g_build_neighbors())
+
+            # --- Step 2: collect words from dict wordlists ------------------
+            # dict.words is already RAM-resident; access under GIL is safe.
+            word_source: List[Tuple[str, str, Set[str]]] = []  # (display_nfd, ks, langs)
+            for dictionary in self.database.hunspell_obj._dictionaries:  # pylint: disable=protected-access
+                lang = dictionary.name.split('_')[0]
+                for word in dictionary.words:
+                    display = unicodedata.normalize('NFD', word)
+                    ks = self._osk_g_key_seq(word)
+                    if ks:
+                        word_source.append((display, ks, {lang}))
+
+            # --- Step 3: collect words from user.db (fresh read-only conn) --
+            freq_map: Dict[str, float] = {}
+            try:
+                conn = _sqlite3.connect(
+                    f'file:{self.database.user_db_file}?mode=ro',
+                    uri=True, check_same_thread=False)
+                rows = conn.execute(
+                    'SELECT phrase, SUM(user_freq) '
+                    'FROM phrases GROUP BY phrase').fetchall()
+                conn.close()
+                for (phrase, freq) in rows:
+                    if not phrase:
+                        continue
+                    nfd_cf = unicodedata.normalize('NFD', phrase.casefold())
+                    freq_map[nfd_cf] = freq_map.get(nfd_cf, 0.0) + (freq or 0.0)
+                    display = unicodedata.normalize('NFD', phrase)
+                    ks = self._osk_g_key_seq(phrase)
+                    if ks:
+                        word_source.append((display, ks, set()))
+            except Exception as e:  # pylint: disable=broad-except
+                LOGGER.warning('osk-gesture: user.db read failed: %s', e)
+
+            # --- Step 4: build dict_words set (for scoring in_dict) ---------
+            dict_words: Set[str] = set()
+            for dictionary in self.database.hunspell_obj._dictionaries:  # pylint: disable=protected-access
+                for word in dictionary.words:
+                    dict_words.add(unicodedata.normalize('NFD', word.casefold()))
+
+            # --- Step 5: dedupe and bucket ---------------------------------
+            # Per bucket: list of (ks, display_nfd, langs_set)
+            # Dedup key: (ks, casefold(display)). On collision keep the
+            # LOWERCASE display variant (user.db holds autocaps case-variants
+            # like "Quiero"/"Ha"/"Que" and SQL GROUP BY yields them first —
+            # rev-10 review: first-seen displays leaked capitalized commits)
+            # and union the langs sets (e.g. en proper-noun "Que" + es "que").
+            entries: Dict[Tuple[str, str], Tuple[str, Set[str]]] = {}
+            for (display, ks, langs) in word_source:
+                dedup_key = (ks, display.casefold())
+                prev = entries.get(dedup_key)
+                if prev is None:
+                    entries[dedup_key] = (display, set(langs))
+                    continue
+                prev_display, prev_langs = prev
+                prev_langs |= langs
+                if (prev_display != prev_display.casefold()
+                        and display == display.casefold()):
+                    entries[dedup_key] = (display, prev_langs)
+            index: Dict[Tuple[str, str], List] = {}
+            for (ks, _cf), (display, langs) in entries.items():
+                bucket_key = (ks[0], ks[-1])
+                if bucket_key not in index:
+                    index[bucket_key] = []
+                index[bucket_key].append((ks, display, langs))
+
+            # --- Step 6: atomic swap ----------------------------------------
+            self._osk_gesture_index = index
+            self._osk_gesture_freq = freq_map
+            self._osk_gesture_dict_words = dict_words
+            elapsed = _time.monotonic() - t0
+            LOGGER.info(
+                'osk-gesture: index built in %.0f ms — %d buckets, '
+                '%d total entries, %d user.db words',
+                elapsed * 1000,
+                len(index),
+                sum(len(v) for v in index.values()),
+                len(freq_map))
+        except Exception as e:  # pylint: disable=broad-except
+            LOGGER.exception('osk-gesture: index build failed: %s', e)
+
+    # --- decode (pure, callable headlessly via §7.4 staticmethod contract) --
+
+    def _osk_gesture_decode(
+            self,
+            trace: List[Tuple[str, bool]]) -> List[str]:
+        """Decode a gesture trace to a ranked list of candidate words.
+
+        trace: [(letter, anchor_bool)], first/last implicitly anchors.
+        Returns up to 8 display-form words, best first."""
+        if not trace or self._osk_gesture_index is None:
+            return []
+        letters = ''.join(l for l, _ in trace)
+        if not letters:
+            return []
+        # anchor_set = explicit anchors ∪ first ∪ last
+        anchor_set: Set[str] = {l for l, a in trace if a}
+        anchor_set.add(letters[0])
+        anchor_set.add(letters[-1])
+
+        neighbors = TypingBoosterEngine._OSK_G_NEIGHBORS
+        active_lang = self._osk_np_active_language()
+
+        # Collect buckets for neighbor-widened first/last
+        first_neighbors = neighbors.get(letters[0], [letters[0]])
+        last_neighbors = neighbors.get(letters[-1], [letters[-1]])
+
+        scored: Dict[str, float] = {}  # casefold(display) → best score
+        best_display: Dict[str, str] = {}  # casefold → display form
+        # casefold → (ks, freq, in_dict, langs) of the best-scoring entry,
+        # kept so the live-freq refresh below can rescore without re-deriving
+        # anything (the rev-10 review replaced a buggy bucket re-lookup that
+        # used cf[-1] — a combining mark for accent-final NFD words).
+        best_ctx: Dict[str, Tuple[str, float, bool, Set[str]]] = {}
+
+        for f in first_neighbors:
+            for l in last_neighbors:
+                bucket = self._osk_gesture_index.get((f, l))
+                if not bucket:
+                    continue
+                for (ks, display, word_langs) in bucket:
+                    if len(ks) > len(letters):
+                        continue
+                    if not self._osk_g_is_subsequence(ks, letters):
+                        continue
+                    cf = display.casefold()
+                    nfd_cf = unicodedata.normalize('NFD', cf)
+                    freq = self._osk_gesture_freq.get(nfd_cf, 0.0)
+                    in_dict = nfd_cf in self._osk_gesture_dict_words
+                    s = self._osk_g_score(
+                        ks, display, letters, anchor_set,
+                        active_lang, freq, in_dict, word_langs)
+                    if cf not in scored or s > scored[cf]:
+                        scored[cf] = s
+                        best_display[cf] = display
+                        best_ctx[cf] = (ks, freq, in_dict, word_langs)
+
+        if not scored:
+            return []
+
+        # Live freq refresh for the top 10 so ranking tracks this session's
+        # learning between index rebuilds (indexed SQLite lookups, ≪ 1 ms).
+        ranked_cf = sorted(scored.keys(), key=lambda k: scored[k], reverse=True)
+        for cf in ranked_cf[:10]:
+            ks, freq, in_dict, word_langs = best_ctx[cf]
+            live_freq = float(self.database.phrase_exists(
+                unicodedata.normalize('NFD', cf)))
+            if live_freq > freq:
+                new_s = self._osk_g_score(
+                    ks, best_display[cf], letters, anchor_set,
+                    active_lang, live_freq, in_dict, word_langs)
+                if new_s > scored[cf]:
+                    scored[cf] = new_s
+
+        ranked_cf = sorted(scored.keys(), key=lambda k: scored[k], reverse=True)
+        return [best_display[cf] for cf in ranked_cf[:8]]
+
+    # --- intercept, finish, fill-strip --------------------------------------
+
+    def _osk_gesture_process(
+            self,
+            key: itb_util_core.KeyEvent,
+            uchar: str) -> Optional[bool]:
+        """Intercept PUA framing characters. Returns True (consumed),
+        False (pass through), or None (not our event — fall through)."""
+        # Always absorb any PUA/Cf char in no-preedit mode, even when gesture
+        # disabled, so stray markers never appear as text in the app (risk #8).
+        _cat = unicodedata.category(uchar[0])
+        if _cat in ('Co', 'Cf'):
+            # Gesture disabled: just absorb silently
+            if not self._osk_gesture_enabled:
+                return True
+
+            # START
+            if uchar[0] == self._OSK_G_START:
+                if self._osk_np_word:
+                    try:
+                        self._osk_np_boundary(key, ' ')
+                    except Exception:  # pylint: disable=broad-except
+                        LOGGER.exception(
+                            'osk-gesture: auto-space boundary failed at '
+                            'gesture start — dropping open word')
+                        self._osk_np_word = ''
+                        self._osk_np_clear_tap_coords()
+                        self._clear_input()
+                self._osk_gesture_trace = []
+                self._osk_gesture_pending_anchor = False
+                self._osk_gesture_shift = False
+                self._osk_gesture_alternates = []
+                return True
+
+            # END
+            if uchar[0] == self._OSK_G_END:
+                if self._osk_gesture_trace is not None:
+                    return self._osk_gesture_finish()
+                return True  # stray END, absorb
+
+            # ANCHOR flag (next letter is anchored)
+            if uchar[0] == self._OSK_G_ANCHOR:
+                if self._osk_gesture_trace is not None:
+                    self._osk_gesture_pending_anchor = True
+                return True
+
+            # SHIFT flag
+            if uchar[0] == self._OSK_G_SHIFT:
+                if self._osk_gesture_trace is not None:
+                    self._osk_gesture_shift = True
+                return True
+
+            # Any other PUA — absorb
+            return True
+
+        # Not a PUA/Cf char at all
+        if self._osk_gesture_trace is None:
+            return None  # not in a trace, pass through
+
+        # We ARE collecting a trace — this must be a letter
+        if 'a' <= uchar[0] <= 'z':
+            is_anchor = self._osk_gesture_pending_anchor
+            self._osk_gesture_pending_anchor = False
+            if len(self._osk_gesture_trace) < self._OSK_G_MAX_TRACE:
+                self._osk_gesture_trace.append((uchar[0], is_anchor))
+            return True
+
+        # Non-letter while collecting (Return, punctuation, etc.): absorb
+        return True
+
+    def _osk_gesture_finish(self) -> bool:
+        """Called on END marker: decode the trace and commit best word."""
+        trace = self._osk_gesture_trace
+        self._osk_gesture_trace = None
+
+        if self._osk_gesture_index is None:
+            # WARNING (→ stderr/journal): a swiped word silently vanishing
+            # must always leave a visible trail (rev-10 review: this was
+            # INFO into a NullHandler — the exact "silent no-decode" trap).
+            LOGGER.warning(
+                'osk-gesture: index not ready (build pending or failed), '
+                'gesture ignored')
+            return True
+
+        if not trace:
+            return True
+
+        decode_start = time.monotonic()
+        try:
+            results = self._osk_gesture_decode(trace)
+        except Exception as e:  # pylint: disable=broad-except
+            LOGGER.exception('osk-gesture: decode error: %s', e)
+            return True
+        decode_ms = (time.monotonic() - decode_start) * 1000.0
+
+        if not results:
+            LOGGER.debug('osk-gesture: no candidates for trace %r (%.1f ms)',
+                         trace, decode_ms)
+            return True
+        LOGGER.debug('osk-gesture: decoded %r -> %r in %.1f ms',
+                     ''.join(l for l, _ in trace), results, decode_ms)
+
+        # Capitalize if the gesture began on the shift level
+        if self._osk_gesture_shift:
+            results = [
+                (w[0].upper() + w[1:]) if w else w for w in results]
+        best = results[0]
+
+        # Commit best word without trailing space (word stays "open"):
+        self.get_context()
+        super().commit_text(IBus.Text.new_from_string(best))
+        self._commit_happened_after_focus_in = True
+        self._osk_np_last_commit_time = time.monotonic()
+        self._osk_np_word = best
+        self._osk_np_clear_tap_coords()
+        self._clear_input()
+        self._insert_string_at_cursor(list(best))
+        self._trigger_surrounding_text_update()
+        self._osk_gesture_alternates = results[:3]
+        self._osk_gesture_fill_strip()
+        return True
+
+    def _osk_gesture_fill_strip(self) -> None:
+        """Sync BOTH _candidates AND the lookup table from _osk_gesture_alternates.
+
+        Both must be updated: get_string_from_lookup_table_cursor_pos() reads
+        _candidates (verified :2226-2231), but update_lookup_table sends the
+        IBus table. Desync = tap-to-replace commits the wrong word (risk #3)."""
+        words = self._osk_gesture_alternates
+        self._candidates = [
+            itb_util_core.PredictionCandidate(
+                phrase=word,
+                user_freq=self._osk_gesture_freq.get(
+                    unicodedata.normalize('NFD', word.casefold()), 0.0),
+                comment='',
+                from_user_db=False,
+                spell_checking=False)
+            for word in words]
+        self._lookup_table.clear()
+        self._lookup_table.set_cursor_visible(False)
+        for cand in self._candidates:
+            self._append_candidate_to_lookup_table(
+                phrase=cand.phrase,
+                user_freq=cand.user_freq,
+                comment=cand.comment,
+                from_user_db=cand.from_user_db,
+                spell_checking=cand.spell_checking)
+        self.update_lookup_table(self.get_lookup_table(), True)
