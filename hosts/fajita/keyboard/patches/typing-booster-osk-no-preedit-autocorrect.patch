+#!/usr/bin/env python3
+"""osk_spatial.py -- engine-embedded port of spatial_corrector.py.
+
+Pure Python, stdlib + sqlite3 ONLY. No gi/IBus/GLib, no third-party libs; this
+module imports cleanly on its own. It is a faithful port of the validated
+standalone scorer at /home/matv/Projects/fajita-spatial/spatial_corrector.py:
+the exact cost model, tunables, geometry, candidate generation, and decision
+gate are preserved. The only structural difference is CONNECTION MANAGEMENT --
+the standalone version hardcoded a module-level DB-path dict + connection cache;
+here the reference DBs and their lazily-opened read-only connections live on the
+SpatialCorrector instance.
+
+Used by hunspell_table.py behind the IBUS_TYPING_BOOSTER_OSK_SPATIAL feature
+flag. The reference dictionaries come from IBUS_TYPING_BOOSTER_REFERENCE_DB
+(a colon-separated list of DB file paths, already split by the caller); each is
+opened strictly READ-ONLY (`mode=ro` + `PRAGMA query_only=ON`) and never
+written. Any failure to open/read a DB degrades gracefully to a conservative
+no-op -- decide() NEVER raises into the engine.
+
+=====================================================================
+FULL COST MODEL
+=====================================================================
+For a literal (what the finger sequence spells) and a candidate word we
+compute a single scalar score; the lowest score wins. Three additive terms:
+
+    score(literal, cand) = spatial_cost
+                         + W_LANG * language_cost
+                         - bigram_bonus
+
+1. SPATIAL COST -- a weighted Damerau/optimal-string-alignment edit distance
+   between the literal and the candidate. Substitutions are proximity-modulated
+   (tap-based when we have real coords, pure-string otherwise); insert/delete/
+   transpose have fixed costs.
+2. LANGUAGE COST -- -log((freq + 1) / 256.0); LANG_COST_OOV for absent words.
+3. BIGRAM BONUS -- BIGRAM_BONUS / rank if prev_word->cand is a known bigram.
+
+=====================================================================
+OFFENSIVE-WORD POLICY
+=====================================================================
+A word is OFFENSIVE if any colon-split flag equals exactly 'offensive' or
+'possibly_offensive'. We NEVER autocorrect TO an offensive word: such a
+candidate can still be scored/returned as the raw best_word, but
+should_autocorrect is forced False for it.
+"""
+
+import functools
+import math
+import sqlite3
+
+# ---------------------------------------------------------------------------
+# GEOMETRY
+# Copied verbatim from /home/matv/nix/hosts/fajita/keyboard/osk-harness.py;
+# must stay BIT-EXACT with that file and should later be shared with it.
+# ---------------------------------------------------------------------------
+_KEY_CENTERS = {
+    'q': (0.5,  0.5), 'w': (1.5,  0.5), 'e': (2.5,  0.5),
+    'r': (3.5,  0.5), 't': (4.5,  0.5), 'y': (5.5,  0.5),
+    'u': (6.5,  0.5), 'i': (7.5,  0.5), 'o': (8.5,  0.5),
+    'p': (9.5,  0.5),
+    'a': (1.0,  1.5), 's': (2.0,  1.5), 'd': (3.0,  1.5),
+    'f': (4.0,  1.5), 'g': (5.0,  1.5), 'h': (6.0,  1.5),
+    'j': (7.0,  1.5), 'k': (8.0,  1.5), 'l': (9.0,  1.5),
+    'z': (2.0,  2.5), 'x': (3.0,  2.5), 'c': (4.0,  2.5),
+    'v': (5.0,  2.5), 'b': (6.0,  2.5), 'n': (7.0,  2.5),
+    'm': (8.0,  2.5),
+}
+
+# ---------------------------------------------------------------------------
+# NAMED TUNABLE CONSTANTS  (no magic numbers below)
+# Values noted "(CHANGED)" differ from the initial spec starting values; see
+# README for the rationale.
+# ---------------------------------------------------------------------------
+SIGMA = 0.6                # Gaussian spread of a tap over the key grid.
+W_LANG = 1.0              # Weight on the language (frequency) term.
+BIGRAM_BONUS = 2.0        # Context reward for a rank-1 known bigram.
+INSERT_COST = 2.2         # Cost to insert a candidate char not in the literal.
+DELETE_COST = 2.2         # Cost to delete a literal char not in the candidate.
+TRANSPOSE_COST = 1.0      # Cost of an adjacent transposition (Damerau/OSA).
+SUB_COST_MAX = 2.5        # Ceiling for any single substitution cost.
+MAX_CANDIDATES = 60       # Hard cap on candidate-set size (keeps latency low).
+AUTOCORRECT_MARGIN = 1.0  # Min score margin (literal - best) to autocorrect.
+SELF_CONFIDENT_FREQ = 90  # If the literal is in-vocab at >= this freq, trust it.
+NEIGHBOR_RADIUS = 1.1     # Euclidean radius for the static _NEIGHBORS table.
+
+# --- extra named tunables ---
+# SUB_SLOPE: pure-string substitution cost per unit key distance.
+#   Chosen so sub_cost('q','w') = SUB_SLOPE * 1.0 stays cheap (~0.95) while
+#   sub_cost('q','p') = SUB_SLOPE * 9.0 saturates to the SUB_COST_MAX ceiling.
+#   Guarantees sub_cost('q','w') < sub_cost('q','p').
+SUB_SLOPE = 0.95
+# LANG_COST_OOV: language cost for an out-of-vocabulary word. Set just above
+#   -log(1/256.0) = 5.545 so any OOV is strictly worse than the rarest real
+#   word (freq 0 -> -log(1/256) = 5.545).
+LANG_COST_OOV = 6.0
+# NORM_RADIUS: neighbourhood radius (in key-widths) used to bound the set of
+#   keys over which a tap distribution is normalized. Larger than NEIGHBOR_RADIUS
+#   so a tap on a border still spreads mass to the correct handful of keys.
+NORM_RADIUS = 1.6
+# TAP_PROB_THRESHOLD: a key is a "plausible" tap target if its normalized tap
+#   probability is >= this. Used to pick plausible first letters for candidate
+#   SQL and plausible substitutions.
+TAP_PROB_THRESHOLD = 0.03
+# SUB_TAP_FLOOR / SUB_TAP_MIN: smallest tap probability allowed before -log
+#   would blow up; exp(-SUB_COST_MAX) makes -log(floor) == SUB_COST_MAX so the
+#   tap-based sub cost saturates at exactly the same ceiling as the pure-string
+#   path.
+SUB_TAP_FLOOR = math.exp(-SUB_COST_MAX)
+SUB_TAP_MIN = SUB_TAP_FLOOR
+# PER_LETTER_LIMIT: SQL LIMIT applied per plausible first letter when pulling
+#   candidate words. Bounds the per-query row count for latency.
+PER_LETTER_LIMIT = 20
+
+_LOG_256 = math.log(256.0)
+
+
+# ---------------------------------------------------------------------------
+# NEIGHBOURS  (built exactly like osk-harness.py)
+# ---------------------------------------------------------------------------
+def _build_neighbors():
+    nb = {}
+    for a, (ax, ay) in _KEY_CENTERS.items():
+        nb[a] = [b for b, (bx, by) in _KEY_CENTERS.items()
+                 if math.sqrt((ax - bx) ** 2 + (ay - by) ** 2) <= NEIGHBOR_RADIUS]
+    return nb
+
+
+_NEIGHBORS = _build_neighbors()
+
+
+# ===========================================================================
+# 1. SPATIAL MODEL
+# ===========================================================================
+def key_center(ch):
+    """Return (col, row) key centre for a single char, or None if not a key.
+
+    Casefolds first so 'H' maps to 'h'.
+    """
+    if not ch:
+        return None
+    c = ch.casefold()
+    return _KEY_CENTERS.get(c)
+
+
+def synth_tap(ch):
+    """Synthesize a *perfect* tap (the key centre) for a char.
+
+    Returns (col, row) for letters, None for non-letters. Used to fabricate
+    idealized taps in tests and as a fallback when real coords are absent.
+    """
+    return key_center(ch)
+
+
+@functools.lru_cache(maxsize=4096)
+def key_distribution(col, row, sigma=SIGMA):
+    """Return {key: prob} tap distribution, normalized to sum 1.
+
+    Unnormalized weight for each key is a Gaussian over Euclidean tap->centre
+    distance: exp(-d^2 / (2*sigma^2)). Normalization is over a BOUNDED
+    neighbourhood: the single nearest key PLUS every key within NORM_RADIUS of
+    the tap. The nearest key is always included even if it lies beyond
+    NORM_RADIUS (guarantees a non-empty distribution for any coordinate).
+
+    A dead-centre tap puts nearly all mass on that key; a tap on the q/w border
+    splits mass between q and w.
+    """
+    two_sigma_sq = 2.0 * sigma * sigma
+    # Find nearest key + all keys within NORM_RADIUS.
+    nearest = None
+    nearest_d = float('inf')
+    in_radius = []
+    for k, (kx, ky) in _KEY_CENTERS.items():
+        d = math.sqrt((col - kx) ** 2 + (row - ky) ** 2)
+        if d < nearest_d:
+            nearest_d = d
+            nearest = k
+        if d <= NORM_RADIUS:
+            in_radius.append((k, d))
+    keys = dict(in_radius)
+    if nearest is not None and nearest not in keys:
+        keys[nearest] = nearest_d
+    # Unnormalized Gaussian weights.
+    weights = {k: math.exp(-(d * d) / two_sigma_sq) for k, d in keys.items()}
+    total = sum(weights.values())
+    if total <= 0.0:
+        # Degenerate: put all mass on the nearest key.
+        return {nearest: 1.0}
+    return {k: w / total for k, w in weights.items()}
+
+
+# ===========================================================================
+# 2. WEIGHTED EDIT DISTANCE
+# ===========================================================================
+@functools.lru_cache(maxsize=8192)
+def _euclid(a, b):
+    ca = _KEY_CENTERS.get(a)
+    cb = _KEY_CENTERS.get(b)
+    if ca is None or cb is None:
+        return None
+    return math.sqrt((ca[0] - cb[0]) ** 2 + (ca[1] - cb[1]) ** 2)
+
+
+@functools.lru_cache(maxsize=8192)
+def sub_cost(a, b):
+    """Pure-string substitution cost between two chars (case-insensitive).
+
+    0 if equal. Else proximity-modulated: min(SUB_COST_MAX, SUB_SLOPE * d)
+    where d is the Euclidean key-centre distance. If either char has no key
+    centre, cost = SUB_COST_MAX. Guarantees sub_cost('q','w') < sub_cost('q','p').
+    """
+    a = a.casefold()
+    b = b.casefold()
+    if a == b:
+        return 0.0
+    d = _euclid(a, b)
+    if d is None:
+        return SUB_COST_MAX
+    return min(SUB_COST_MAX, SUB_SLOPE * d)
+
+
+def _tap_sub_cost(tap_dist, c):
+    """Tap-based substitution cost aligning a tapped position to cand char c.
+
+    Exact formula:
+        p    = tap_dist.get(c, 0.0)
+        p    = min(1.0, max(SUB_TAP_MIN, p))     # clamp into [SUB_TAP_MIN, 1.0]
+        cost = min(SUB_COST_MAX, -log(p))
+    With SUB_TAP_MIN = exp(-SUB_COST_MAX), an absent/zero prob saturates at
+    exactly SUB_COST_MAX. A dead-on tap (p~1) costs ~0.
+    """
+    c = c.casefold()
+    p = tap_dist.get(c, 0.0)
+    if p < SUB_TAP_MIN:
+        p = SUB_TAP_MIN
+    elif p > 1.0:
+        p = 1.0
+    return min(SUB_COST_MAX, -math.log(p))
+
+
+@functools.lru_cache(maxsize=16384)
+def _pure_edit(literal, candidate, cap):
+    """Pure-string weighted OSA edit distance (cached). cap may be None."""
+    return _edit_core(literal, candidate, None, cap)
+
+
+def weighted_edit_distance(literal, candidate, tap_dists=None, cap=None):
+    """Weighted Damerau/OSA edit distance between literal and candidate.
+
+    Substitutions are proximity-modulated. With tap_dists (one key->prob dict
+    per literal position) substitutions use the tap-based cost; otherwise the
+    pure-string cost. Adjacent transpositions allowed (OSA). Insert/delete/
+    transpose use INSERT_COST / DELETE_COST / TRANSPOSE_COST. If cap is not
+    None and a whole DP row's running minimum exceeds cap, return cap + 1.
+    """
+    if tap_dists is None:
+        # Cacheable pure-string path.
+        return _pure_edit(literal, candidate, cap)
+    return _edit_core(literal, candidate, tap_dists, cap)
+
+
+def _edit_core(literal, candidate, tap_dists, cap):
+    n = len(literal)
+    m = len(candidate)
+    if n == 0:
+        return m * INSERT_COST
+    if m == 0:
+        return n * DELETE_COST
+
+    # Standard 1-indexed DP. prev2 holds row i-2 for transposition.
+    prev = [j * INSERT_COST for j in range(m + 1)]
+    prev2 = None
+    for i in range(1, n + 1):
+        cur = [0.0] * (m + 1)
+        cur[0] = i * DELETE_COST
+        li = literal[i - 1]
+        tap_i = tap_dists[i - 1] if tap_dists is not None else None
+        row_min = cur[0]
+        for j in range(1, m + 1):
+            cj = candidate[j - 1]
+            if tap_i is not None:
+                # Tap-based sub cost; 0 if the tapped char literally equals cj.
+                if li.casefold() == cj.casefold():
+                    sc = 0.0
+                else:
+                    sc = _tap_sub_cost(tap_i, cj)
+            else:
+                sc = sub_cost(li, cj)
+            best = prev[j - 1] + sc                    # substitution / match
+            del_c = prev[j] + DELETE_COST              # delete literal char
+            if del_c < best:
+                best = del_c
+            ins_c = cur[j - 1] + INSERT_COST           # insert candidate char
+            if ins_c < best:
+                best = ins_c
+            # Adjacent transposition (OSA).
+            if (i > 1 and j > 1
+                    and li.casefold() == candidate[j - 2].casefold()
+                    and literal[i - 2].casefold() == cj.casefold()):
+                tr = prev2[j - 2] + TRANSPOSE_COST
+                if tr < best:
+                    best = tr
+            cur[j] = best
+            if best < row_min:
+                row_min = best
+        if cap is not None and row_min > cap:
+            return cap + 1
+        prev2 = prev
+        prev = cur
+    return prev[m]
+
+
+# ===========================================================================
+# 3. CANDIDATE GENERATION  (bounded; never a full-table scan)
+# ===========================================================================
+def _plausible_letters_at(literal, i, tap_dists):
+    """The char at position i plus its plausible spatial neighbours.
+
+    With taps: every key whose tap prob at position i is >= TAP_PROB_THRESHOLD.
+    Without taps: the static _NEIGHBORS of the char. Always includes the
+    literal's own char at i.
+    """
+    ch = literal[i].casefold()
+    out = {ch}
+    if tap_dists is not None and i < len(tap_dists) and tap_dists[i]:
+        for k, p in tap_dists[i].items():
+            if p >= TAP_PROB_THRESHOLD:
+                out.add(k)
+    else:
+        for k in _NEIGHBORS.get(ch, ()):
+            out.add(k)
+    return out
+
+
+def _plausible_first_letters(literal, tap_dists):
+    """First letter plus its plausible spatial neighbours (position 0)."""
+    return _plausible_letters_at(literal, 0, tap_dists)
+
+
+def _sub_probe_strings(literal, i, tap_dists):
+    """One-position substitution probe strings for position i.
+
+    Replaces literal[i] with each plausible ALTERNATIVE key: with taps, every
+    key at tap_dists[i] with prob >= TAP_PROB_THRESHOLD (except the literal
+    char); without taps, the static neighbours. We probe *all* plausible alts
+    (not just the single best) because the top alt is often a wrong-direction
+    neighbour (e.g. a perfect 'q' tap ranks 'w' above 'a'), and missing the
+    right one silently kills recall for real single-key slips. Still bounded --
+    at most a handful of alts per position.
+    """
+    li = literal[i].casefold()
+    alts = []
+    if tap_dists is not None and tap_dists[i]:
+        for k, p in tap_dists[i].items():
+            if k != li and p >= TAP_PROB_THRESHOLD:
+                alts.append(k)
+    else:
+        for k in _NEIGHBORS.get(li, ()):
+            if k != li:
+                alts.append(k)
+    return [literal[:i] + a + literal[i + 1:] for a in alts]
+
+
+def _transpose_probe_strings(literal):
+    """Adjacent-transposition probe strings: the n-1 single-swap variants.
+
+    Swaps each adjacent pair (0,1),(1,2),...,(n-2,n-1), e.g. 'teh' ->
+    {'eth','the'}. A first-two-letter transposition changes the literal's
+    prefix, so the correct word is never fetched by the prefix ranges; probing
+    the swapped strings by exact lookup recovers it (the scorer already ranks
+    adjacent transpositions via TRANSPOSE_COST). Pure and bounded -- adjacent
+    swaps only. Skips swaps of identical chars (they reproduce the literal).
+    """
+    out = []
+    for i in range(len(literal) - 1):
+        if literal[i] != literal[i + 1]:
+            out.append(literal[:i] + literal[i + 1] + literal[i] + literal[i + 2:])
+    return out
+
+
+def candidates(literal, conn, tap_dists=None):
+    """Return a bounded list of (word, freq, flags) candidate rows.
+
+    Strategy (recall vs latency): we never scan the full table. We pull, per
+    plausible first letter, up to PER_LETTER_LIMIT of the highest-frequency
+    words whose length is within +-1 of the literal, then probe single-position
+    substitutions. This catches the vast majority of one/two-error typos while
+    keeping each query index-bounded. The tradeoff: rarer or longer-distance
+    corrections (>1 substitution far from the literal, or low-freq words beyond
+    the per-letter cut) can be missed -- acceptable for an OSK where recall on
+    common words matters far more than exhaustiveness. Final set capped at
+    MAX_CANDIDATES keeping the highest-freq rows.
+
+    Prefix lookups use indexed half-open ranges (lowercase + uppercase) rather
+    than `LIKE`, which under BINARY collation would full-scan the table; the two
+    ranges together still catch capitalized dictionary words like 'Holt'.
+
+    Adjacent-transposition probe strings (the n-1 single-swap variants) are also
+    resolved in the same batched IN(...) query, recovering first-two-letter
+    swaps whose changed prefix the range queries would otherwise miss.
+    """
+    cur = conn.cursor()
+    rows = {}  # lower(word) -> (word, freq, flags)
+    protected = set()  # lower(word)s that must survive the frequency cap
+
+    def add(word, freq, flags, protect=False):
+        key = word.lower()
+        old = rows.get(key)
+        # Prefer a row with a real (higher) freq / real casing.
+        if old is None or (freq is not None and (old[1] is None or freq > old[1])):
+            rows[key] = (word, freq, flags)
+        if protect:
+            protected.add(key)
+
+    # (a) Always include the literal (look up its real row if present).
+    lit_key = literal.lower()
+    cur.execute("SELECT word,freq,flags FROM unigrams WHERE word=?", (literal,))
+    r = cur.fetchone()
+    if r is not None:
+        add(r[0], r[1], r[2], protect=True)
+    else:
+        add(literal, None, None, protect=True)
+
+    n = len(literal)
+    lo = max(1, n - 1)
+    hi = n + 1
+
+    # (b) Prefix queries, length-banded.
+    #
+    # IMPORTANT (latency): a `word LIKE 'h%'` predicate does NOT use the
+    # unigrams(word) PRIMARY-KEY index under the default BINARY collation, so it
+    # degrades to a full-table scan (~10 ms). We instead use indexed half-open
+    # RANGE bounds `word >= lo AND word < hi`. And because a single-letter range
+    # over a ~700k-word dictionary is still huge (all c-words: ~7 ms with the
+    # ORDER BY freq sort), we key on the first TWO letters, which shrinks each
+    # range ~30x. Case: BINARY range bounds are case-sensitive, so we run a
+    # lowercase and an uppercase variant per prefix -- together they reproduce
+    # LIKE's ASCII case-insensitivity (capitalized words like 'Holt' stay
+    # reachable). We generate a "cross" of two-letter prefixes:
+    #   * literal[:2]                         (the exact typed prefix)
+    #   * plausible-first-letter + literal[1] (first-letter slips)
+    #   * literal[0] + plausible-second-letter (second-letter slips)
+    # Single-key slips at every position are ALSO caught cheaply by the exact
+    # substitution probes in step (c), so this cross is sufficient recall at a
+    # fraction of the single-letter-range cost.
+    two_prefixes = set()
+    if n >= 2:
+        # Full 2D cross of plausible first x second letters. This catches
+        # simultaneous first+second-letter slips (e.g. 'yj' -> 'th' for
+        # 'the'); a mere union of single-letter variations would miss those.
+        # With real/synthetic taps each position's plausible set is small
+        # (top few keys above TAP_PROB_THRESHOLD), so the product stays a few
+        # dozen tiny indexed range queries.
+        first_letters = _plausible_first_letters(literal, tap_dists)
+        second_letters = _plausible_letters_at(literal, 1, tap_dists)
+        for fl in first_letters:
+            for sl in second_letters:
+                two_prefixes.add((fl + sl).lower())
+        prefix_iter = ((p, PER_LETTER_LIMIT) for p in two_prefixes)
+    else:
+        # 1-char literal: fall back to single-letter ranges (rare; guards
+        # already reject len<2, so this is defensive only).
+        prefix_iter = ((literal[0].lower(), PER_LETTER_LIMIT),)
+
+    for prefix, limit in prefix_iter:
+        for pfx in (prefix, prefix[:1].upper() + prefix[1:]):
+            lo_b = pfx
+            hi_b = pfx[:-1] + chr(ord(pfx[-1]) + 1)
+            cur.execute(
+                "SELECT word,freq,flags FROM unigrams "
+                "WHERE word >= ? AND word < ? "
+                "AND length(word) BETWEEN ? AND ? "
+                "ORDER BY freq DESC LIMIT ?",
+                (lo_b, hi_b, lo, hi, limit),
+            )
+            for w, f, fg in cur.fetchall():
+                add(w, f, fg)
+
+    # (c) Single-position substitution probes: for each position, every
+    #     plausible alternative key. Adjacent-transposition probe strings (the
+    #     n-1 single-swap variants) are folded into the same set. Collect all
+    #     probe strings, dedup, and resolve them in one IN(...) query to keep
+    #     this a single round-trip.
+    probes = set()
+    for i in range(n):
+        for p in _sub_probe_strings(literal, i, tap_dists):
+            if p.lower() != lit_key:
+                probes.add(p)
+    for p in _transpose_probe_strings(literal):
+        if p.lower() != lit_key:
+            probes.add(p)
+    if probes:
+        plist = list(probes)
+        qmarks = ','.join('?' * len(plist))
+        cur.execute(
+            f"SELECT word,freq,flags FROM unigrams WHERE word IN ({qmarks})",
+            plist,
+        )
+        # Probe hits are single-key-distance from the literal by construction,
+        # so they are the most spatially relevant corrections -- protect them
+        # from the frequency cap (a low-freq near word like 'hola' must not be
+        # evicted by a crowd of high-freq prefix matches).
+        for w, f, fg in cur.fetchall():
+            add(w, f, fg, protect=True)
+
+    # Cap at MAX_CANDIDATES keeping highest-freq bulk rows, but ALWAYS keep the
+    # protected set (literal + substitution-probe hits) -- these are the rows
+    # the scorer most needs to see. None freq sorts last.
+    if len(rows) > MAX_CANDIDATES:
+        prot_rows = [rows[k] for k in protected if k in rows]
+        rest = [rows[k] for k in rows if k not in protected]
+        rest.sort(key=lambda t: (t[1] is not None, t[1] or 0), reverse=True)
+        keep = max(0, MAX_CANDIDATES - len(prot_rows))
+        result = prot_rows + rest[:keep]
+    else:
+        result = list(rows.values())
+    return result
+
+
+# ===========================================================================
+# OFFENSIVE-WORD DETECTION
+# ===========================================================================
+def is_offensive(flags):
+    """True if any colon-split flag is exactly 'offensive'/'possibly_offensive'."""
+    if not flags:
+        return False
+    for f in flags.split(':'):
+        if f == 'offensive' or f == 'possibly_offensive':
+            return True
+    return False
+
+
+# ===========================================================================
+# 4. COMBINED SCORING
+# ===========================================================================
+def _bigram_rank(conn, prev_word, cand_word):
+    """rank of (prev_word, cand_word) bigram, or None. Cached per-connection."""
+    cache = _BIGRAM_CACHE.setdefault(id(conn), {})
+    key = (prev_word, cand_word)
+    if key in cache:
+        return cache[key]
+    cur = conn.execute(
+        "SELECT rank FROM bigrams WHERE prev=? AND word=?",
+        (prev_word, cand_word),
+    )
+    row = cur.fetchone()
+    rank = row[0] if row is not None else None
+    cache[key] = rank
+    return rank
+
+
+_BIGRAM_CACHE = {}
+
+
+def language_cost(freq):
+    """-log((freq+1)/256.0); LANG_COST_OOV when freq is None (absent word)."""
+    if freq is None:
+        return LANG_COST_OOV
+    return -(math.log(freq + 1) - _LOG_256)
+
+
+def bigram_bonus(conn, prev_word, cand_word):
+    """BIGRAM_BONUS/rank if (prev_word, cand_word) is a known bigram, else 0."""
+    if not prev_word:
+        return 0.0
+    rank = _bigram_rank(conn, prev_word.lower(), cand_word.lower())
+    if rank is None:
+        return 0.0
+    return BIGRAM_BONUS / rank
+
+
+def score(literal, cand_word, freq, flags, tap_dists, prev_word, conn):
+    """Combined score (lower is better).
+
+        score = spatial_cost + W_LANG * language_cost - bigram_bonus
+    """
+    spatial = weighted_edit_distance(literal, cand_word, tap_dists)
+    lang = language_cost(freq)
+    bonus = bigram_bonus(conn, prev_word, cand_word)
+    return spatial + W_LANG * lang - bonus
+
+
+# ===========================================================================
+# 5. HELPERS
+# ===========================================================================
+def _has_digit(s):
+    return any(c.isdigit() for c in s)
+
+
+def _build_tap_dists(taps):
+    """Convert a list of (col,row) taps into a list of key->prob dicts.
+
+    Non-letter positions (tap is None) yield an empty dict.
+    """
+    out = []
+    for t in taps:
+        if t is None:
+            out.append({})
+        else:
+            out.append(key_distribution(t[0], t[1]))
+    return out
+
+
+# ===========================================================================
+# 6. SPATIAL CORRECTOR  (engine-embedded entry point)
+# ===========================================================================
+# Sentinel cached in self._conn_cache to mark a language whose DB is known to be
+# absent/unreadable, so we do not retry sqlite3.connect on every decide() call.
+_FAILED = object()
+
+
+class SpatialCorrector:
+    """Instance-scoped spatial autocorrect over read-only reference DBs.
+
+    reference_db_paths is a list[str] of DB file paths (already split from the
+    colon-separated IBUS_TYPING_BOOSTER_REFERENCE_DB by the caller). The
+    language key for each path is derived from the basename: strip a trailing
+    '.db', then take the substring before the first '_' if present, lowercased
+    ('en_US.db' -> 'en', 'es.db' -> 'es'). DBs are opened lazily and strictly
+    read-only; connection failures degrade to a conservative no-op.
+    """
+
+    def __init__(self, reference_db_paths):
+        # lang -> DB path. No DB is opened here (lazy).
+        self._db_paths = {}
+        for path in reference_db_paths:
+            base = path.rsplit('/', 1)[-1]
+            if base.endswith('.db'):
+                base = base[:-3]
+            lang = base.split('_', 1)[0].lower()
+            # First path for a given lang wins (stable, deterministic).
+            if lang and lang not in self._db_paths:
+                self._db_paths[lang] = path
+        # lang -> sqlite3.Connection, or _FAILED sentinel for known-bad DBs.
+        self._conn_cache = {}
+
+    def _get_conn(self, lang):
+        """Return a cached READ-ONLY connection for the given language.
+
+        Opened with mode=ro + PRAGMA query_only=ON + mmap for latency. Never
+        writes. Returns None when there is no DB for this language, or when the
+        DB is missing/unreadable/corrupt (any exception is swallowed and the
+        failure is cached so we never retry or raise).
+        """
+        cached = self._conn_cache.get(lang)
+        if cached is _FAILED:
+            return None
+        if cached is not None:
+            return cached
+        if lang not in self._db_paths:
+            return None
+        path = self._db_paths[lang]
+        try:
+            conn = sqlite3.connect(f'file:{path}?mode=ro', uri=True,
+                                   check_same_thread=False)
+            conn.execute('PRAGMA query_only=ON')
+            conn.execute('PRAGMA mmap_size=268435456')
+        except Exception:
+            # Missing/unreadable/corrupt DB: cache the failure, never raise.
+            self._conn_cache[lang] = _FAILED
+            return None
+        self._conn_cache[lang] = conn
+        return conn
+
+    def decide(self, typed, taps=None, prev_word=None, lang='en'):
+        """Decide the best word for a typed key sequence.
+
+        Returns (best_word, confidence, should_autocorrect):
+          * best_word: lowest-scoring candidate (literal or a correction), with
+            the leading capital preserved if typed[0] is uppercase.
+          * confidence: margin = literal_score - best_score (0.0 if best IS the
+            literal). Positive means a candidate beats the literal.
+          * should_autocorrect: True only if ALL hold --
+              best differs from literal (case-insensitive),
+              margin >= AUTOCORRECT_MARGIN,
+              literal is NOT in-vocab at freq >= SELF_CONFIDENT_FREQ,
+              best_word is not offensive,
+              best_word has no digits/spaces/hyphens.
+
+        Guards (return (typed, 0.0, False) immediately): the literal contains
+        any digit, or len < 2, or len > 24.
+
+        NEVER raises into the engine: any internal exception returns the safe
+        no-op (typed, 0.0, False).
+        """
+        try:
+            return self._decide(typed, taps, prev_word, lang)
+        except Exception:
+            # Any internal failure -> safe no-op; caller keeps the literal.
+            return (typed, 0.0, False)
+
+    def _decide(self, typed, taps, prev_word, lang):
+        literal = typed
+        # --- guards ---
+        if len(literal) < 2 or len(literal) > 24 or _has_digit(literal):
+            return (typed, 0.0, False)
+
+        if taps is None:
+            taps = [synth_tap(c) for c in typed]
+        tap_dists = _build_tap_dists(taps)
+
+        conn = self._get_conn(lang)
+        if conn is None:
+            # No DB for this lang: spatial-only; we never autocorrect without a
+            # frequency prior -- conservative fallback, caller may then use the
+            # legacy corrector. Preserve the leading capital and return no-op.
+            out_word = typed
+            if typed and typed[0].isupper() and out_word:
+                out_word = out_word[0].upper() + out_word[1:]
+            return (out_word, 0.0, False)
+
+        cand_rows = candidates(literal, conn, tap_dists)
+
+        # Literal's own freq/flags (may be OOV).
+        lit_lower = literal.lower()
+        lit_freq = None
+        lit_flags = None
+        for w, f, fg in cand_rows:
+            if w.lower() == lit_lower:
+                lit_freq = f
+                lit_flags = fg
+                break
+
+        # Score everything.
+        best_word = literal
+        best_score = score(literal, literal, lit_freq, lit_flags,
+                           tap_dists, prev_word, conn)
+        literal_score = best_score
+        for w, f, fg in cand_rows:
+            if w.lower() == lit_lower:
+                continue
+            s = score(literal, w, f, fg, tap_dists, prev_word, conn)
+            if s < best_score:
+                best_score = s
+                best_word = w
+
+        if best_word.lower() == lit_lower:
+            margin = 0.0
+        else:
+            margin = literal_score - best_score
+
+        # --- autocorrect gate ---
+        self_confident = (lit_freq is not None and lit_freq >= SELF_CONFIDENT_FREQ)
+        # Look up best_word flags for offensive check.
+        best_flags = None
+        for w, f, fg in cand_rows:
+            if w.lower() == best_word.lower():
+                best_flags = fg
+                break
+        best_clean = not (_has_digit(best_word)
+                          or ' ' in best_word or '-' in best_word)
+        should_autocorrect = (
+            best_word.lower() != lit_lower
+            and margin >= AUTOCORRECT_MARGIN
+            and not self_confident
+            and not is_offensive(best_flags)
+            and best_clean
+        )
+
+        # Preserve leading capital.
+        out_word = best_word
+        if typed and typed[0].isupper() and out_word:
+            out_word = out_word[0].upper() + out_word[1:]
+
+        return (out_word, margin, should_autocorrect)
