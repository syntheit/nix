+        // The viewfinder already runs at the max negotiated resolution on
+        // this stack, so nothing is lost: photo == viewfinder by
+        // construction.
+        let Some(sample) = imp
+            .wysiwyg_sink
+            .get()
+            .and_then(|sink| sink.property::<Option<gst::Sample>>("last-sample"))
+        else {
+            return Err(crate::CaptureError::NotReady);
+        };
+
         // Set after we cannot fail anymore.
