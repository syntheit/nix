+/// fajita: one-shot memory pipeline that rotates a raw video sample per
+/// `direction` and writes it to `path` as JPEG. Runs synchronously — call
+/// from a worker thread. Pure CPU elements, no camera involvement, so it
+/// cannot touch the fragile camss power domains.
+fn encode_oriented_jpeg(
+    sample: &gst::Sample,
+    direction: gst_video::VideoOrientationMethod,
+    path: &Path,
+) -> Result<(), String> {
+    let caps = sample.caps().ok_or("sample has no caps")?.to_owned();
+    let buffer = sample.buffer_owned().ok_or("sample has no buffer")?;
+
+    let pipeline = gst::Pipeline::default();
+    let appsrc = gst::ElementFactory::make("appsrc")
+        .property("caps", &caps)
+        .build()
+        .map_err(|err| format!("appsrc: {err}"))?;
+    let flip = gst::ElementFactory::make("videoflip")
+        .property("video-direction", direction)
+        .build()
+        .map_err(|err| format!("videoflip: {err}"))?;
+    let convert = gst::ElementFactory::make("videoconvert")
+        .build()
+        .map_err(|err| format!("videoconvert: {err}"))?;
+    let enc = gst::ElementFactory::make("jpegenc")
+        .property("quality", 90i32)
+        .build()
+        .map_err(|err| format!("jpegenc: {err}"))?;
+    let sink = gst::ElementFactory::make("filesink")
+        .property("location", path.display().to_string())
+        .build()
+        .map_err(|err| format!("filesink: {err}"))?;
+
+    pipeline
+        .add_many([&appsrc, &flip, &convert, &enc, &sink])
+        .map_err(|err| err.to_string())?;
+    gst::Element::link_many([&appsrc, &flip, &convert, &enc, &sink])
+        .map_err(|err| err.to_string())?;
+
+    pipeline
+        .set_state(gst::State::Playing)
+        .map_err(|err| err.to_string())?;
+    let push_ret = appsrc.emit_by_name::<gst::FlowReturn>("push-buffer", &[&buffer]);
+    let _ = appsrc.emit_by_name::<gst::FlowReturn>("end-of-stream", &[]);
+
+    let msg = pipeline.bus().and_then(|bus| {
+        bus.timed_pop_filtered(
+            gst::ClockTime::from_seconds(10),
+            &[gst::MessageType::Eos, gst::MessageType::Error],
+        )
+    });
+    let _ = pipeline.set_state(gst::State::Null);
+
+    if push_ret != gst::FlowReturn::Ok {
+        return Err(format!("push-buffer: {push_ret:?}"));
+    }
+    match msg {
+        Some(msg) => match msg.view() {
+            gst::MessageView::Eos(_) => Ok(()),
+            gst::MessageView::Error(err) => Err(err.error().to_string()),
+            _ => Err("unexpected bus message".into()),
+        },
+        None => Err("JPEG encode timed out".into()),
+    }
+}
