         let filename = utils::picture_file_name(format);
         let path = utils::pictures_dir()?.join(filename);
 
+        // fajita flash (gsettings key `flash-enabled`, default off):
+        //  - rear: strobe the pmi8998 LED via sysfs (kernel self-terminates
+        //    the strobe; node is group-video writable via udev rule);
+        //  - front: paint the panel warm-white BEFORE capture so it lights
+        //    the subject while the sensor integrates.
+        let settings = imp.settings();
+        let flash_enabled = settings.boolean("flash-enabled");
+        let is_front = imp
+            .viewfinder
+            .camera()
+            .map(|c| !matches!(c.location(), aperture::CameraLocation::Back))
+            .unwrap_or(false);
+        if flash_enabled {
+            if is_front {
+                // 2.2s rise-hold-fall so the panel is still lit when the
+                // pipeline's image-mode switch finally exposes (~0.5-1s).
+                imp.flash_bin.flash_warm();
+                glib::timeout_future(std::time::Duration::from_millis(50)).await;
+            } else {
+                // Strobe now and re-strobe across the capture-latency
+                // window — camerabin's mode switch delays real exposure.
+                let _ = std::fs::write(
+                    "/sys/class/leds/white:flash/flash_strobe",
+                    "1",
+                );
+                for delay in [400u64, 800] {
+                    glib::timeout_add_local_once(
+                        std::time::Duration::from_millis(delay),
+                        || {
+                            let _ = std::fs::write(
+                                "/sys/class/leds/white:flash/flash_strobe",
+                                "1",
+                            );
+                        },
+                    );
+                }
+            }
+        }
+
         imp.viewfinder.take_picture(path)?;
-        imp.flash_bin.flash();
+        if !(flash_enabled && is_front) {
+            imp.flash_bin.flash();
+        }
 
-        let settings = imp.settings();
         if settings.boolean("play-shutter-sound") {
             self.play_shutter_sound();
         }
