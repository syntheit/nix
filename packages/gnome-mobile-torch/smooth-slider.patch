--- a/src/device.js
+++ b/src/device.js
@@ -89,28 +89,79 @@ export class TorchDevice extends GObject.Object {
     this.#set_brightness(brightness);
   }
 
-  #set_brightness(brightness) {
-    if (this.brightness == brightness) return;
+  /**
+   * Queue a non-blocking brightness write, replacing any value that has not
+   * reached logind yet. Slider motion must never block GNOME Shell's UI loop.
+   */
+  queue_scaled_brightness(frac) {
+    const clamped = Math.max(0, Math.min(1, frac));
+    const brightness = Math.round(clamped * this.max_brightness);
+    this.#queueBrightness(brightness);
+  }
 
-    console.debug(`Setting brightness to ${brightness}`);
+  #pendingBrightness = null;
+  #brightnessWriteInFlight = false;
 
-    if (!this.#dbus_proxy) return;
+  #queueBrightness(brightness) {
+    if (brightness === this.#brightness &&
+        this.#pendingBrightness === null) return;
+
+    this.#pendingBrightness = brightness;
+    this.#applyOptimisticBrightness(brightness);
+    this.#flushPendingBrightness();
+  }
+
+  #applyOptimisticBrightness(brightness) {
+    if (this.#brightness === brightness) return;
+
+    this.freeze_notify();
+    this.#brightness = brightness;
+    this.notify("brightness");
+    this.notify("scaled-brightness");
+    this.notify("on");
+    this.thaw_notify();
+  }
+
+  #flushPendingBrightness() {
+    if (this.#brightnessWriteInFlight ||
+        this.#pendingBrightness === null || !this.#dbus_proxy) return;
+
+    const brightness = this.#pendingBrightness;
+    this.#pendingBrightness = null;
+    this.#brightnessWriteInFlight = true;
 
     const args = GLib.Variant.new("(ssu)", [
       this.#udev_device.get_subsystem(),
       this.#udev_device.get_name(),
       brightness,
     ]);
-
-    this.#dbus_proxy.call_sync(
+    this.#dbus_proxy.call(
       "SetBrightness",
       args,
       Gio.DBusCallFlags.NONE,
       -1,
       null,
+      (proxy, result) => {
+        try {
+          proxy.call_finish(result);
+        } catch (error) {
+          logError(error, `Failed to set flashlight LED ${this.name}`);
+          if (this.#pendingBrightness === null)
+            this.apply_brightness();
+        } finally {
+          this.#brightnessWriteInFlight = false;
+          this.#flushPendingBrightness();
+        }
+      },
     );
+  }
 
-    this.apply_brightness();
+  flush_pending_brightness() {
+    this.#flushPendingBrightness();
+  }
+
+  #set_brightness(brightness) {
+    this.#queueBrightness(brightness);
   }
 
   #last_brightness = 0;
