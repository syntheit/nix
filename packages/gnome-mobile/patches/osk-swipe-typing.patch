+    clear() {
+        this._container.destroy_all_children();
+        this._lastX = null;
+        this._lastY = null;
+    }
+
+    fadeOut() {
+        // Dots already self-destroy via ease; just clear the tracking state
+        this._lastX = null;
+        this._lastY = null;
+    }
+
+    destroy() {
+        this._container.destroy();
+    }
