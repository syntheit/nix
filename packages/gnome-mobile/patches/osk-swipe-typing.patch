+            if (Math.sqrt(dx * dx + dy * dy) < GESTURE_TRAIL_DOT_PX)
+                return; // throttle: too close to last dot
+        }
+
+        this._lastX = x;
+        this._lastY = y;
+
+        const dot = new St.Widget({style_class: 'gesture-trail-dot'});
+        dot.width = 14;
+        dot.height = 14;
+        dot.x = x - 7;
+        dot.y = y - 7;
+        dot.set_pivot_point(0.5, 0.5); // shrink toward the dot center
+        this._container.add_child(dot);
+
+        dot.ease({
+            opacity: 0,
+            scale_x: 0.4,
+            scale_y: 0.4,
+            duration: 280,
+            mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+            onComplete: () => dot.destroy(),
+        });
+    }
