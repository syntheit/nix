+class GestureTrail {
+    constructor(container) {
+        // Overlay container on top of the key grid (BinLayout covers all children)
+        this._container = new St.Widget({reactive: false});
+        container.add_child(this._container);
+        this._lastX = null;
+        this._lastY = null;
+    }
+
+    addPoint(x, y) {
+        if (this._lastX !== null) {
+            const dx = x - this._lastX;
+            const dy = y - this._lastY;
+            if (Math.sqrt(dx * dx + dy * dy) < GESTURE_TRAIL_DOT_PX)
+                return; // throttle: too close to last dot
+        }
+
+        this._lastX = x;
+        this._lastY = y;
+
+        const dot = new St.Widget({style_class: 'gesture-trail-dot'});
+        dot.width = 14;
+        dot.height = 14;
+        dot.x = x - 7;
+        dot.y = y - 7;
+        this._container.add_child(dot);
+
+        dot.ease({
+            opacity: 0,
+            scale_x: 0.4,
+            scale_y: 0.4,
+            duration: 280,
+            mode: Clutter.AnimationMode.EASE_OUT_QUAD,
+            onComplete: () => dot.destroy(),
+        });
+    }
+
+    clear() {
+        this._container.destroy_all_children();
+        this._lastX = null;
+        this._lastY = null;
+    }
+
+    fadeOut() {
+        // Dots already self-destroy via ease; just clear the tracking state
+        this._lastX = null;
+        this._lastY = null;
+    }
+
+    destroy() {
+        this._container.destroy();
+    }
