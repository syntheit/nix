+    // fajita: emit a swipe-typing trace to the engine as press-only PUA key events.
+    // Format: U+F8D0 start … [U+F8D4 shift] … [U+F8D2 anchor] letters … U+F8D1 end.
+    // Same-connection ordering guarantees letters arrive before F8D1; the engine
+    // decodes on F8D1 and emits commit-text synchronously on the D-Bus connection,
+    // so committedTail is updated by the time the returned promise resolves.
+    async injectGestureTrace(letters, anchors, shift) {
+        if (!this._context)
+            return;
+        const pua = cp => 0x01000000 | cp;
+        const anchorSet = new Set(anchors);
+        const seq = [pua(0xF8D0)]; // gesture start
+        if (shift)
+            seq.push(pua(0xF8D4));  // shift marker
+        [...letters].forEach((c, i) => {
+            if (anchorSet.has(i))
+                seq.push(pua(0xF8D2)); // anchor marker before this letter
+            const cp = c.codePointAt(0);
+            // For a–z, use the ASCII keyval directly (matches IBus key event convention)
+            seq.push(cp >= 0x61 && cp <= 0x7a ? cp : pua(cp));
+        });
+        seq.push(pua(0xF8D1)); // gesture end → decode
+        // Fire all but the last without awaiting (same connection = ordered
+        // delivery). NOTE: process_key_event_async is Gio._promisify'd with
+        // a 5-argument call shape — the extra trailing null made gjs invoke
+        // the C function with 7 args ("Too many arguments" warning per
+        // event). Keep exactly 5 args and detach the returned promises.
+        for (let i = 0; i < seq.length - 1; i++) {
+            this._context.process_key_event_async(seq[i], 0, 0, -1, null)
+                .catch(() => {});
+        }
+        // Await the last so callers know the decode + commit happened
+        await this._context.process_key_event_async(seq.at(-1), 0, 0, -1, null);
+    }
+
     _fullReset() {
         this._context.set_content_type(0, 0);
         this._context.set_cursor_location(0, 0, 0, 0);
