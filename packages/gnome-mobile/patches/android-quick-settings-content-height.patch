+class QuickSettingsShadeLayout extends Clutter.LayoutManager {
+    _init() {
+        super._init();
+        this._messageList = null;
+    }
+
+    setMessageList(messageList) {
+        this._messageList = messageList;
+        this.layout_changed();
+    }
+
+    _getContentHeight(child, forWidth) {
+        const [fixedHeight] = child.get_preferred_height(forWidth);
+        const messageHeight =
+            this._messageList?.getContentPreferredHeight(forWidth) ?? 0;
+        return Math.max(0, fixedHeight) + Math.max(0, messageHeight);
+    }
+
+    vfunc_get_preferred_width(container, forHeight) {
+        return container.get_children().reduce(([min, nat], child) => {
+            if (!child.visible)
+                return [min, nat];
+
+            const [childMin, childNat] =
+                child.get_preferred_width(forHeight);
+            return [Math.max(min, childMin), Math.max(nat, childNat)];
+        }, [0, 0]);
+    }
+
+    vfunc_get_preferred_height(container, forWidth) {
+        const height = container.get_children().reduce((preferred, child) => {
+            if (!child.visible)
+                return preferred;
+
+            return Math.max(
+                preferred, this._getContentHeight(child, forWidth));
+        }, 0);
+        return [height, height];
+    }
+
+    vfunc_allocate(container, box) {
+        const availableWidth = box.x2 - box.x1;
+        const availableHeight = box.y2 - box.y1;
+
+        for (const child of container) {
+            if (!child.visible)
+                continue;
+
+            const [minimumHeight] =
+                child.get_preferred_height(availableWidth);
+            const messageHeight =
+                this._messageList?.getContentPreferredHeight(availableWidth) ?? 0;
+            const contentHeight =
+                Math.max(0, minimumHeight) + Math.max(0, messageHeight);
+            const allocationHeight =
+                Math.min(contentHeight, availableHeight);
+            const childBox = new Clutter.ActorBox();
+            childBox.set_origin(box.x1, box.y1);
+            childBox.set_size(availableWidth, allocationHeight);
+            child.allocate(childBox);
+        }
+    }
+});
