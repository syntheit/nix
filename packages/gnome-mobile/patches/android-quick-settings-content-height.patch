@@ -842,0 +853,51 @@ const QuickSettingsLayout = GObject.registerClass({
+const QuickSettingsShadeLayout = GObject.registerClass(
+class QuickSettingsShadeLayout extends Clutter.LayoutManager {
+    vfunc_get_preferred_width(container, forHeight) {
+        return container.get_children().reduce(([min, nat], child) => {
+            if (!child.visible)
+                return [min, nat];
+
+            const [childMin, childNat] =
+                child.get_preferred_width(forHeight);
+            return [Math.max(min, childMin), Math.max(nat, childNat)];
+        }, [0, 0]);
+    }
+
+    vfunc_get_preferred_height(container, forWidth) {
+        return container.get_children().reduce(([min, nat], child) => {
+            if (!child.visible)
+                return [min, nat];
+
+            const [childMin, childNat] =
+                child.get_preferred_height(forWidth);
+            return [Math.max(min, childMin), Math.max(nat, childNat)];
+        }, [0, 0]);
+    }
+
+    vfunc_allocate(container, box) {
+        const availableWidth = box.x2 - box.x1;
+        const availableHeight = box.y2 - box.y1;
+
+        for (const child of container) {
+            if (!child.visible)
+                continue;
+
+            const [, naturalHeight] =
+                child.get_preferred_height(availableWidth);
+            const allocationHeight =
+                Math.min(naturalHeight, availableHeight);
+            const geometry =
+                `${availableWidth}x${availableHeight}:${naturalHeight}`;
+            if (this._lastGeometry !== geometry) {
+                this._lastGeometry = geometry;
+                console.log(`Quick Settings shade geometry: ${geometry}`);
+            }
+
+            const childBox = new Clutter.ActorBox();
+            childBox.set_origin(box.x1, box.y1);
+            childBox.set_size(availableWidth, allocationHeight);
+            child.allocate(childBox);
+        }
+    }
+});
+
