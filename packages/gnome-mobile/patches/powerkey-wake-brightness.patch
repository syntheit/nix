         this._sensorDaemonProxy.UndimBacklightAsync(0).catch(e =>
             log("POWERMANAGER: Undim backlight failed: " + e));
-
-        this._displayConfigProxy.PowerSaveMode = 0;
-        await this._fadeIn();
     }
 
     async _fadeOut(duration) {
