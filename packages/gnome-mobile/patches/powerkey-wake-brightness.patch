+        // Power the panel FIRST. The brightness restores below end up as sysfs
+        // writes, and on DSI panels the kernel rejects those while the panel is
+        // off or still preparing (EINVAL) - doing them before the DPMS change
+        // meant the restore was silently lost on every wake, so in the worst
+        // case the panel came back at an invisible brightness ("wakes but stays
+        // black"). The fade-in gives the panel time to finish preparing before
+        // the writes land.
+        this._displayConfigProxy.PowerSaveMode = 0;
+        await this._fadeIn();
+
         if (this._adaptiveBacklightInhibited) {
