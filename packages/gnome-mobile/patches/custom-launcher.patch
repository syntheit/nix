diff --git a/js/ui/customLauncher.js b/js/ui/customLauncher.js
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/js/ui/customLauncher.js
@@ -0,0 +1,449 @@
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+
+const LAUNCHER_CONFIG = '/etc/gnome-shell-mobile/launcher.json';
+
+const AZ = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
+
+export const CustomLauncher = GObject.registerClass(
+class CustomLauncher extends St.Widget {
+    _init() {
+        super._init({
+            style_class: 'custom-launcher',
+            x_expand: true,
+            y_expand: true,
+            reactive: false, // CRITICAL: root must NOT be reactive, so a center
+                             // swipe-up still reaches the shell's app-switcher gesture
+            layout_manager: new Clutter.BinLayout(),
+        });
+
+        // Stored for later Today-View paging; a no-op store is correct for phase 1.
+        this._leadingPageAdjustment = null;
+        this._folderPopup = null;
+
+        this._scrubOverlay = null;
+        this._activeLetter = null;
+        this._lastScrubXY = null;
+
+        this._rebuildAppIndex();
+        this._buildFavorites();
+
+        // Strip first so the overlay child is added LAST and renders on top.
+        this._buildAzStrip();
+        this._buildScrubOverlay();
+
+        this.connect('notify::opacity', () => this._syncScrubEnabled());
+        this.connect('notify::visible', () => this._syncScrubEnabled());
+        this._syncScrubEnabled();
+
+        Shell.AppSystem.get_default().connectObject('installed-changed', () => {
+            this._rebuildAppIndex();
+            this._rebuildFavorites();
+        }, this);
+
+        this.connect('destroy', () => this._onDestroy());
+    }
+
+    // Overview contract: the overview stores an adjustment on us for Today-View
+    // paging. We just keep a reference; if this method is missing the shell
+    // throws at init and the screen goes blank.
+    setLeadingPageAdjustment(adjustment) {
+        this._leadingPageAdjustment = adjustment;
+    }
+
+    // Overview contract: the org.gnome.Shell.FocusApp D-Bus path
+    // (overview.selectApp → appDisplay.selectApp) calls this to highlight an
+    // app in the grid. showApps() has already surfaced us; we have no per-app
+    // selection UI, so this is intentionally a no-op (prevents a TypeError on
+    // that D-Bus path).
+    selectApp(_id) {
+    }
+
+    _rebuildAppIndex() {
+        this._appInfoById = new Map();
+        this._sortedApps = [];
+
+        for (const appInfo of Shell.AppSystem.get_default().get_installed()) {
+            let id;
+            try {
+                id = appInfo.get_id(); // catch invalid file encodings
+            } catch {
+                continue;
+            }
+
+            this._appInfoById.set(id, appInfo);
+
+            if (appInfo.should_show())
+                this._sortedApps.push(appInfo);
+        }
+
+        this._sortedApps.sort((a, b) =>
+            a.get_name().toLowerCase().localeCompare(b.get_name().toLowerCase()));
+
+        this._buckets = new Map();
+        for (const letter of AZ)
+            this._buckets.set(letter, []);
+        for (const app of this._sortedApps) {
+            const ch = (app.get_name().trim()[0] || '#').toUpperCase();
+            const key = (ch >= 'A' && ch <= 'Z') ? ch : '#';
+            this._buckets.get(key).push(app);
+        }
+    }
+
+    _loadConfig() {
+        try {
+            const file = Gio.File.new_for_path(LAUNCHER_CONFIG);
+            const [ok, contents] = file.load_contents(null);
+            if (!ok)
+                return null;
+
+            const config = JSON.parse(new TextDecoder().decode(contents));
+            if (config.version !== 1 || !Array.isArray(config.favorites))
+                return null;
+
+            return config.favorites;
+        } catch {
+            return null;
+        }
+    }
+
+    _fallbackEntries() {
+        return this._sortedApps.slice(0, 8).map(appInfo => ({
+            type: 'app',
+            desktopId: appInfo.get_id(),
+        }));
+    }
+
+    _buildFavorites() {
+        this._favoritesBox = new St.BoxLayout({
+            style_class: 'custom-launcher-favorites',
+            orientation: Clutter.Orientation.VERTICAL,
+            x_align: Clutter.ActorAlign.CENTER,
+            y_align: Clutter.ActorAlign.CENTER,
+            x_expand: true,
+            y_expand: true,
+            style: 'spacing: 10px;',
+        });
+        this.add_child(this._favoritesBox);
+
+        this._rebuildFavorites();
+    }
+
+    _rebuildFavorites() {
+        this._favoritesBox.destroy_all_children();
+
+        const entries = this._loadConfig() ?? this._fallbackEntries();
+
+        for (const entry of entries) {
+            const type = entry.type ?? 'app';
+
+            if (type === 'folder') {
+                this._favoritesBox.add_child(this._makeFolderRow(entry));
+            } else {
+                const appInfo = this._appInfoById.get(entry.desktopId);
+                if (!appInfo) {
+                    console.warn(
+                        `CustomLauncher: could not resolve favorite app “${entry.desktopId}”`);
+                    continue;
+                }
+
+                this._favoritesBox.add_child(this._makeAppRow(appInfo, false));
+            }
+        }
+    }
+
+    _buildAzStrip() {
+        this._azStrip = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            reactive: true,
+            x_align: Clutter.ActorAlign.END,
+            y_align: Clutter.ActorAlign.FILL,
+            y_expand: true,
+            style: 'padding: 4px 6px;',
+        });
+
+        for (const letter of AZ) {
+            this._azStrip.add_child(new St.Label({
+                text: letter,
+                x_align: Clutter.ActorAlign.CENTER,
+                y_expand: true,
+                y_align: Clutter.ActorAlign.CENTER,
+                style: 'font-size: 12px; font-weight: 600;',
+            }));
+        }
+
+        this.add_child(this._azStrip);
+        this._setupScrubGesture();
+    }
+
+    _buildScrubOverlay() {
+        this._scrubOverlay = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            reactive: true,
+            visible: false,
+            x_align: Clutter.ActorAlign.END,
+            y_align: Clutter.ActorAlign.START,
+            style: 'background-color: rgba(32,32,34,0.98); ' +
+                'border-radius: 18px; padding: 8px; spacing: 4px;',
+        });
+        this.add_child(this._scrubOverlay);
+    }
+
+    _setupScrubGesture() {
+        const pan = new Clutter.PanGesture({ max_n_points: 1 });
+        pan.connect('may-recognize', () => true);
+        pan.connect('recognize', () => {
+            const c = pan.get_begin_centroid();
+            this._scrubTo(c.x, c.y);
+        });
+        pan.connect('pan-update', () => {
+            const c = pan.get_centroid();
+            this._scrubTo(c.x, c.y);
+        });
+        pan.connect('end', () => this._scrubCommit());
+        pan.connect('cancel', () => this._scrubDismiss());
+        pan.enabled = false;
+        this._azStrip.add_action_full(
+            'launcher-az-scrub', Clutter.EventPhase.BUBBLE, pan);
+        this._scrubGesture = pan;
+    }
+
+    _syncScrubEnabled() {
+        const enabled = this.visible && this.opacity >= 255;
+        if (this._scrubGesture)
+            this._scrubGesture.enabled = enabled;
+        if (!enabled)
+            this._scrubDismiss();
+    }
+
+    _scrubTo(x, y) {
+        this._lastScrubXY = { x, y };
+
+        const [ , stripY] = this._azStrip.get_transformed_position();
+        const stripH = Math.max(this._azStrip.get_height(), 1);
+        const frac = Math.clamp((y - stripY) / stripH, 0, 1);
+        const idx = Math.min(AZ.length - 1, Math.floor(frac * AZ.length));
+        const letter = AZ[idx];
+
+        if (letter !== this._activeLetter) {
+            this._activeLetter = letter;
+            this._showLetter(letter);
+        }
+
+        this._positionOverlay(y);
+    }
+
+    _showLetter(letter) {
+        this._scrubOverlay.destroy_all_children();
+
+        const apps = this._buckets.get(letter) || [];
+        if (apps.length === 0) {
+            this._scrubOverlay.visible = false;
+            return;
+        }
+
+        // CAP to 12 (a ScrollView here would crash the shell).
+        for (const appInfo of apps.slice(0, 12)) {
+            const row = this._makeAppRow(appInfo, false, () => {
+                this._scrubDismiss();
+                this._launch(appInfo);
+            });
+            row._launcherApp = appInfo;
+            this._scrubOverlay.add_child(row);
+        }
+
+        this._scrubOverlay.visible = true;
+    }
+
+    _positionOverlay(y) {
+        if (!this._scrubOverlay.visible)
+            return;
+
+        const [ , launcherY] = this.get_transformed_position();
+        const H = Math.max(this.get_height(), 1);
+        const oh = this._scrubOverlay.get_height();
+        const stripW = this._azStrip.get_width();
+
+        this._scrubOverlay.translation_y =
+            Math.clamp((y - launcherY) - oh / 2, 0, Math.max(H - oh, 0));
+        this._scrubOverlay.translation_x = -(stripW + 12);
+    }
+
+    _scrubCommit() {
+        const p = this._lastScrubXY;
+        if (p) {
+            const actor = global.stage.get_actor_at_pos(
+                Clutter.PickMode.REACTIVE, p.x, p.y);
+            let a = actor;
+            while (a) {
+                if (a._launcherApp) {
+                    this._scrubDismiss();
+                    this._launch(a._launcherApp);
+                    return;
+                }
+                a = a.get_parent();
+            }
+        }
+        this._scrubDismiss();
+    }
+
+    _scrubDismiss() {
+        this._activeLetter = null;
+        this._lastScrubXY = null;
+        if (this._scrubOverlay) {
+            this._scrubOverlay.destroy_all_children();
+            this._scrubOverlay.visible = false;
+            this._scrubOverlay.translation_x = 0;
+            this._scrubOverlay.translation_y = 0;
+        }
+    }
+
+    _makeAppRow(appInfo, indented, onActivate) {
+        const button = new St.Button({
+            style_class: 'custom-launcher-row' +
+                (indented ? ' custom-launcher-row-indented' : ''),
+            style: 'padding: 12px 20px; border-radius: 14px;',
+            x_expand: true,
+            can_focus: true,
+        });
+
+        const box = new St.BoxLayout({
+            style_class: 'custom-launcher-row-box',
+            orientation: Clutter.Orientation.HORIZONTAL,
+            style: 'spacing: 16px;',
+        });
+
+        box.add_child(new St.Icon({
+            gicon: appInfo.get_icon(),
+            icon_size: 40,
+            style_class: 'custom-launcher-icon',
+        }));
+        box.add_child(new St.Label({
+            text: appInfo.get_name(),
+            y_align: Clutter.ActorAlign.CENTER,
+            style_class: 'custom-launcher-label',
+            style: 'font-size: 20px; font-weight: 500;',
+        }));
+
+        button.set_child(box);
+        const activate = onActivate ?? (() => this._launch(appInfo));
+        button.connect('clicked', activate);
+
+        return button;
+    }
+
+    _makeFolderRow(entry) {
+        const button = new St.Button({
+            style_class: 'custom-launcher-row custom-launcher-folder-row',
+            style: 'padding: 12px 20px; border-radius: 14px;',
+            x_expand: true,
+            can_focus: true,
+        });
+
+        const box = new St.BoxLayout({
+            style_class: 'custom-launcher-row-box',
+            orientation: Clutter.Orientation.HORIZONTAL,
+            style: 'spacing: 16px;',
+        });
+
+        box.add_child(new St.Icon({
+            icon_name: entry.iconName || 'folder-symbolic',
+            icon_size: 40,
+            style_class: 'custom-launcher-icon',
+        }));
+        box.add_child(new St.Label({
+            text: entry.title,
+            y_align: Clutter.ActorAlign.CENTER,
+            style_class: 'custom-launcher-label',
+            style: 'font-size: 20px; font-weight: 500;',
+        }));
+
+        button.set_child(box);
+        button.connect('clicked', () => this._openFolderPopup(entry));
+
+        return button;
+    }
+
+    _openFolderPopup(entry) {
+        this._closeFolderPopup();
+
+        this._folderPopup = new St.Widget({
+            layout_manager: new Clutter.BinLayout(),
+            reactive: true,
+            x_expand: true,
+            y_expand: true,
+            style: 'background-color: rgba(0,0,0,0.55);',
+        });
+
+        const card = new St.BoxLayout({
+            orientation: Clutter.Orientation.VERTICAL,
+            reactive: true,
+            x_align: Clutter.ActorAlign.CENTER,
+            y_align: Clutter.ActorAlign.CENTER,
+            style: 'background-color: rgba(32,32,34,0.98); border-radius: 24px; ' +
+                'padding: 20px 16px; spacing: 8px; min-width: 300px;',
+        });
+
+        card.add_child(new St.Label({
+            text: entry.title,
+            x_align: Clutter.ActorAlign.CENTER,
+            style: 'font-size: 22px; font-weight: 700; padding-bottom: 10px;',
+        }));
+
+        const members = Array.isArray(entry.apps) ? entry.apps : [];
+        for (const id of members) {
+            const appInfo = this._appInfoById.get(id);
+            if (!appInfo)
+                continue;
+
+            card.add_child(this._makeAppRow(appInfo, false, () => {
+                this._closeFolderPopup();
+                this._launch(appInfo);
+            }));
+        }
+
+        this._folderPopup.add_child(card);
+        this.add_child(this._folderPopup);
+
+        this._folderPopup.connect('button-press-event', () => {
+            this._closeFolderPopup();
+            return Clutter.EVENT_STOP;
+        });
+    }
+
+    _closeFolderPopup() {
+        if (this._folderPopup) {
+            this._folderPopup.destroy();
+            this._folderPopup = null;
+        }
+    }
+
+    _launch(appInfo) {
+        try {
+            const app = Shell.AppSystem.get_default().lookup_app(appInfo.get_id());
+            if (app)
+                app.activate();
+            else
+                appInfo.launch([], global.create_app_launch_context(0, -1));
+            Main.overview.hide();
+        } catch (e) {
+            logError(e, 'CustomLauncher: failed to launch app');
+        }
+    }
+
+    vfunc_unmap() {
+        this._closeFolderPopup();
+        this._scrubDismiss();
+        super.vfunc_unmap();
+    }
+
+    _onDestroy() {
+        // connectObject with `this` owner auto-disconnects on destroy; phase 1
+        // allocates no GLib timers, so nothing else to clean up here.
+    }
+});
