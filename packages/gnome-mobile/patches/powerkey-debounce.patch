diff --git a/js/misc/powerManager.js b/js/misc/powerManager.js
index ce89bed5c..b9240388e 100644
--- a/js/misc/powerManager.js
+++ b/js/misc/powerManager.js
@@ -43,6 +43,15 @@ const SensorDaemonProxy = Gio.DBusProxy.makeProxyWrapper(SensorDaemonIface);
 
 const DEFAULT_SCREEN_FADE_OUT_TIME_MS = 250;
 
+// The OnePlus 6T pm8941 pwrkey emits a doubled KEY_POWER press on the
+// sdm845-mainline kernel. When the screen is blanked, press #1 wakes it (cancels
+// the blank action, clearing _isInAction); press #2 then sees no action ongoing
+// and arms _powerPressHappened, so the following release blanks the screen right
+// back — the "press several times to wake" symptom. Drop press events that
+// arrive within this window of the previous one (releases are unaffected, so
+// press-to-blank still works).
+const POWER_PRESS_DEBOUNCE_MS = 400;
+
 Gio._promisify(Shell, 'util_start_systemd_unit');
 Gio._promisify(Shell, 'util_stop_systemd_unit');
 
@@ -1143,6 +1152,15 @@ log("POWERMANAGER: turn on this._fadeInTimeout " + this._fadeInTimeout + " this.
         } else {
  //   log("POWERMANAGER: power key press, flags " +  event.get_flags() + " " + (event.get_flags() & Clutter.EventFlags.FLAG_INPUT_METHOD));
 
+            if (this._lastPowerPressMs !== undefined &&
+                timeNowMs - this._lastPowerPressMs < POWER_PRESS_DEBOUNCE_MS) {
+                // Doubled pwrkey press (see POWER_PRESS_DEBOUNCE_MS) — ignore it,
+                // but keep the timer sliding so a longer bounce train stays quiet.
+                this._lastPowerPressMs = timeNowMs;
+                return;
+            }
+            this._lastPowerPressMs = timeNowMs;
+
             if (this._ignoreInputAfterSuspend) {
                 log("POWERMANAGER: ignoring power key press (event age " + (timeNowMs - eventTimeMs) + "ms) after suspend wakeup (" + (timeNowMs - this._ignoreInputAfterSuspendStartMs) + "ms after wakeup)");
                 return;
