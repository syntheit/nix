diff --git a/js/ui/shellWidgets.js b/js/ui/shellWidgets.js
new file mode 100644
--- /dev/null
+++ b/js/ui/shellWidgets.js
@@ -0,0 +1,210 @@
+import Clutter from 'gi://Clutter';
+import GnomeDesktop from 'gi://GnomeDesktop';
+import GLib from 'gi://GLib';
+import GObject from 'gi://GObject';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import {formatDateWithCFormatString} from '../misc/dateUtils.js';
+
+const LOCK_SCREEN_WIDGETS_KEY = 'lock-screen-widgets';
+const TODAY_VIEW_WIDGETS_KEY = 'today-view-widgets';
+
+const _widgetRegistry = new Map();
+
+export const ShellWidget = GObject.registerClass(
+class ShellWidget extends St.BoxLayout {
+    static get id() {
+        return null;
+    }
+
+    static get title() {
+        return _('Widget');
+    }
+
+    static get preferredHeight() {
+        return -1;
+    }
+
+    static get defaultRefreshInterval() {
+        return 0;
+    }
+
+    constructor(context = {}) {
+        super({
+            style_class: 'shell-widget',
+            orientation: Clutter.Orientation.VERTICAL,
+            x_expand: true,
+            y_expand: false,
+        });
+
+        this._context = Object.freeze({
+            isOnLockscreen: Boolean(context.isOnLockscreen),
+        });
+        this._refreshTimeoutId = 0;
+
+        this.connect('destroy', () => this._stopRefreshTimer());
+    }
+
+    get preferredHeight() {
+        return this.constructor.preferredHeight;
+    }
+
+    update() {
+    }
+
+    vfunc_map() {
+        super.vfunc_map();
+
+        this.update();
+        this._startRefreshTimer();
+    }
+
+    vfunc_unmap() {
+        this._stopRefreshTimer();
+
+        super.vfunc_unmap();
+    }
+
+    _startRefreshTimer() {
+        const interval = this.constructor.defaultRefreshInterval;
+        if (this._refreshTimeoutId || interval <= 0)
+            return;
+
+        this._refreshTimeoutId = GLib.timeout_add_seconds(
+            GLib.PRIORITY_DEFAULT, interval, () => {
+                this.update();
+                return GLib.SOURCE_CONTINUE;
+            });
+        GLib.Source.set_name_by_id(this._refreshTimeoutId,
+            `[gnome-shell] ${this.constructor.id} widget refresh`);
+    }
+
+    _stopRefreshTimer() {
+        if (!this._refreshTimeoutId)
+            return;
+
+        GLib.source_remove(this._refreshTimeoutId);
+        this._refreshTimeoutId = 0;
+    }
+});
+
+export function registerWidget(id, factory, meta = {}) {
+    if (!id || typeof id !== 'string')
+        throw new TypeError('Widget id must be a non-empty string');
+    if (typeof factory !== 'function')
+        throw new TypeError(`Widget factory for ${id} must be a function`);
+    if (_widgetRegistry.has(id))
+        throw new Error(`Widget ${id} is already registered`);
+
+    _widgetRegistry.set(id, Object.freeze({
+        id,
+        factory,
+        meta: Object.freeze({...meta}),
+    }));
+}
+
+export function getRegisteredWidgets() {
+    return [..._widgetRegistry.values()];
+}
+
+export const WidgetHost = GObject.registerClass(
+class WidgetHost extends St.Widget {
+    constructor(context = {}) {
+        const isOnLockscreen = Boolean(context.isOnLockscreen);
+        super({
+            style_class: isOnLockscreen
+                ? 'widget-host lock-screen-widget-host'
+                : 'widget-host today-view-widget-host',
+            layout_manager: new Clutter.BoxLayout({
+                orientation: Clutter.Orientation.VERTICAL,
+                spacing: 12,
+            }),
+            x_expand: true,
+            y_expand: false,
+        });
+
+        this._context = Object.freeze({isOnLockscreen});
+        this._settingsKey = isOnLockscreen
+            ? LOCK_SCREEN_WIDGETS_KEY
+            : TODAY_VIEW_WIDGETS_KEY;
+
+        global.settings.connectObject(`changed::${this._settingsKey}`,
+            () => this._syncWidgets(), this);
+        this._syncWidgets();
+    }
+
+    _syncWidgets() {
+        this.destroy_all_children();
+
+        for (const id of global.settings.get_strv(this._settingsKey)) {
+            const definition = _widgetRegistry.get(id);
+            if (!definition) {
+                console.warn(`Ignoring unknown shell widget “${id}”`);
+                continue;
+            }
+
+            try {
+                this.add_child(definition.factory(this._context));
+            } catch (error) {
+                console.error(`Failed to create shell widget “${id}”:`, error);
+            }
+        }
+
+        this.visible = this.get_n_children() > 0;
+    }
+});
+
+const ClockWidget = GObject.registerClass(
+class ClockWidget extends ShellWidget {
+    static get id() {
+        return 'clock';
+    }
+
+    static get title() {
+        return _('Clock');
+    }
+
+    static get preferredHeight() {
+        return 96;
+    }
+
+    constructor(context) {
+        super(context);
+
+        this.add_style_class_name('shell-widget-clock');
+
+        this._timeLabel = new St.Label({
+            style_class: 'shell-widget-clock-time',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        this._dateLabel = new St.Label({
+            style_class: 'shell-widget-clock-date',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        this.add_child(this._timeLabel);
+        this.add_child(this._dateLabel);
+
+        this._wallClock = new GnomeDesktop.WallClock({time_only: true});
+        this._wallClock.connect('notify::clock', () => this.update());
+
+        this.connect('destroy', () => this._wallClock.run_dispose());
+    }
+
+    update() {
+        if (!this._wallClock)
+            return;
+
+        this._timeLabel.text = this._wallClock.clock.trim();
+
+        const date = new Date();
+        const dateFormat = Shell.util_translate_time_string(N_('%A, %B %-d'));
+        this._dateLabel.text = formatDateWithCFormatString(date, dateFormat);
+    }
+});
+
+registerWidget(ClockWidget.id, context => new ClockWidget(context), {
+    title: ClockWidget.title,
+    preferredHeight: ClockWidget.preferredHeight,
+    defaultRefreshInterval: ClockWidget.defaultRefreshInterval,
+});
