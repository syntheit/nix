+    // Deferred nudge: re-fit the focused window into the current work area.
+    // Called after both strut-set and strut-remove so maximized windows snap
+    // to the right size without mutter's lone configure being raced away.
+    _refitFocusWindow() {
+        const laters = global.compositor.get_laters();
+        laters.add(Meta.LaterType.BEFORE_REDRAW, () => {
+            const focus = global.display.focus_window;
+            if (!focus || !focus.maximized_vertically)
+                return false;
+            const wa = focus.get_work_area_current_monitor();
+            const fr = focus.get_frame_rect();
+            if (fr.height !== wa.height || fr.y !== wa.y)
+                focus.move_resize_frame(false, fr.x, wa.y, fr.width, wa.height);
+            return false;
+        });
+    }
