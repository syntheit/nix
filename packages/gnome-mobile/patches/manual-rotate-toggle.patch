+const DISPLAY_CONFIG_NAME = 'org.gnome.Mutter.DisplayConfig';
+const DISPLAY_CONFIG_PATH = '/org/gnome/Mutter/DisplayConfig';
+
+// Manual portrait/landscape toggle for devices without a working
+// accelerometer (no iio sensor → auto-rotate can't work): directly flips
+// the monitor transform via the DisplayConfig D-Bus API. Only shown when
+// the auto-rotate toggle above isn't available.
+const ManualRotateToggle = GObject.registerClass(
+class ManualRotateToggle extends QuickToggle {
+    _init() {
+        super._init({
+            title: _('Rotate'),
+            iconName: 'rotation-allowed-symbolic',
+        });
+
+        this._systemActions = new SystemActions.getDefault();
+        this._systemActions.bind_property('can-lock-orientation',
+            this, 'visible',
+            GObject.BindingFlags.INVERT_BOOLEAN |
+            GObject.BindingFlags.SYNC_CREATE);
+
+        this.connect('clicked', () => this._toggleRotation().catch(logError));
+    }
+
+    async _toggleRotation() {
+        const reply = await Gio.DBus.session.call(
+            DISPLAY_CONFIG_NAME, DISPLAY_CONFIG_PATH, DISPLAY_CONFIG_NAME,
+            'GetCurrentState', null, null,
+            Gio.DBusCallFlags.NONE, -1, null);
+        const [serial, monitors, logicalMonitors] = reply.recursiveUnpack();
+
+        const current = logicalMonitors[0][3];
+        const transform = current === 0 ? 3 : 0; // portrait ↔ landscape (270°)
+
+        const newLogical = logicalMonitors.map(
+            ([x, y, scale, _transform, primary, assigned]) => {
+                const physical = assigned.map(([connector]) => {
+                    const monitor = monitors.find(
+                        ([[conn]]) => conn === connector);
+                    const mode = monitor[1].find(m => m[6]['is-current']);
+                    return [connector, mode[0], {}];
+                });
+                return [x, y, scale, transform, primary, physical];
+            });
+
+        await Gio.DBus.session.call(
+            DISPLAY_CONFIG_NAME, DISPLAY_CONFIG_PATH, DISPLAY_CONFIG_NAME,
+            'ApplyMonitorsConfig',
+            new GLib.Variant('(uua(iiduba(ssa{sv}))a{sv})',
+                [serial, 1, newLogical, {}]), // 1 = temporary (portrait again on reboot)
+            null, Gio.DBusCallFlags.NONE, -1, null);
+
+        this.checked = transform !== 0;
+    }
+});
+
 export const Indicator = GObject.registerClass(
 class Indicator extends SystemIndicator {
     _init() {
         super._init();
 
         this.quickSettingsItems.push(new RotationToggle());
+        this.quickSettingsItems.push(new ManualRotateToggle());
     }
 });
