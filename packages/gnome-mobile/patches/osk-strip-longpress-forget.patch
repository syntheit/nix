diff --git a/js/ui/keyboard.js b/js/ui/keyboard.js
index df6ba9588..6287076ed 100644
--- a/js/ui/keyboard.js
+++ b/js/ui/keyboard.js
@@ -221,9 +221,34 @@ class Suggestions extends St.BoxLayout {
         this.add_child(secondButton);
         this.add_child(firstButton);
         this.add_child(thirdButton);
+
+        // fajita: long-press on a strip suggestion → forget word from user
+        // DB. ONE persistent gesture per pill, attached here for the
+        // button's whole life: the first version created and removed a
+        // LongPressGesture on EVERY strip update (i.e. every keystroke),
+        // churning the compositor's global gesture negotiation while a
+        // finger was on the keyboard. add()/clear() only swap the callback.
+        for (const button of this._buttons) {
+            const longPressGesture = new Clutter.LongPressGesture({
+                name: 'suggestion-forget',
+                long_press_duration_ms: 600,
+            });
+            longPressGesture.connect('notify::state', () => {
+                if (longPressGesture.state !== Clutter.GestureState.RECOGNIZING)
+                    return;
+                if (!button._forgetCallback)
+                    return;
+                button._forgetCallback();
+                // Brief visual flash: dim + restore to signal removal
+                button.ease({opacity: 100, duration: 80, onComplete: () => {
+                    button.ease({opacity: 255, duration: 120});
+                }});
+            });
+            button.add_action(longPressGesture);
+        }
     }
 
