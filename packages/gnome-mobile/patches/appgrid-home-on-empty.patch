     }
 
+    _trackActiveWorkspaceWindows() {
+        const workspace = global.workspace_manager.get_active_workspace();
+        if (this._homeTrackedWorkspace === workspace)
+            return;
+
+        this._homeTrackedWorkspace?.disconnectObject(this);
+        this._homeTrackedWorkspace = workspace;
+        workspace.connectObject('window-removed',
+            () => this._goHomeIfPickerEmpty(), this);
+    }
+
+    _goHomeIfPickerEmpty() {
+        if (!Main.layoutManager.is_phone || !Main.overview.visible)
+            return;
+        if (this._searchController.searchActive)
+            return;
+
+        const {finalState} = this._stateAdjustment.getStateTransitionParams();
+        if (finalState !== ControlsState.WINDOW_PICKER)
+            return;
+
+        const workspace = global.workspace_manager.get_active_workspace();
+        const hasWindows = workspace.list_windows().some(
+            w => w.showing_on_its_workspace() && !w.is_skip_taskbar());
+        if (hasWindows)
+            return;
+
+        // Last card closed -> land on the home app-grid, not an empty picker.
+        this.dash.showAppsButton.checked = true;
+    }
+
     vfunc_unmap() {
