+const TORCH_ICON_PATH =
+    '/run/current-system/sw/share/gnome-shell/extensions/' +
+    'torch@vixalien.com/data/icons/torch-on-symbolic.svg';
+
+class LockScreenTorch {
+    constructor() {
+        const client = GUdev.Client.new(['leds']);
+        const enumerator = GUdev.Enumerator.new(client);
+        enumerator.add_match_subsystem('leds');
+        enumerator.add_match_name('*:torch');
+        enumerator.add_match_name('*:flash');
+
+        this._devices = enumerator.execute();
+        this._proxy = this._devices.length > 0
+            ? Gio.DBusProxy.new_for_bus_sync(
+                Gio.BusType.SYSTEM,
+                Gio.DBusProxyFlags.NONE,
+                null,
+                'org.freedesktop.login1',
+                '/org/freedesktop/login1/session/auto',
+                'org.freedesktop.login1.Session',
+                null)
+            : null;
+    }
+
+    get available() {
+        return this._devices.length > 0 && this._proxy !== null;
+    }
+
+    get enabled() {
+        return this._devices.some(device =>
+            device.get_sysfs_attr_as_int_uncached('brightness') > 0);
+    }
+
+    toggle() {
+        if (!this.available)
+            return false;
+
+        const enable = !this.enabled;
+        for (const device of this._devices) {
+            const brightness = enable
+                ? device.get_sysfs_attr_as_int('max_brightness')
+                : 0;
+            const args = new GLib.Variant('(ssu)', [
+                device.get_subsystem(),
+                device.get_name(),
+                brightness,
+            ]);
+            this._proxy.call_sync(
+                'SetBrightness',
+                args,
+                Gio.DBusCallFlags.NONE,
+                -1,
+                null);
+        }
+
+        return this.enabled;
+    }
+}
