+const SolarWidget = GObject.registerClass(
+class SolarWidget extends ShellWidget {
+    static get id() {
+        return 'solar';
+    }
+
+    static get title() {
+        return _('Sunrise & Sunset');
+    }
+
+    static get preferredHeight() {
+        return 126;
+    }
+
+    static get defaultRefreshInterval() {
+        return 60;
+    }
+
+    constructor(context) {
+        super(context);
+
+        this.add_style_class_name('shell-widget-solar');
+        this._weatherClient = getSharedWeatherClient();
+        this._solarInfo = null;
+        this._solarLocation = null;
+        this._solarDateKey = '';
+
+        const header = new St.BoxLayout({
+            style_class: 'shell-widget-solar-header',
+            x_expand: true,
+        });
+        this._titleLabel = new St.Label({
+            style_class: 'shell-widget-solar-title',
+            text: _('Sun'),
+            x_align: Clutter.ActorAlign.START,
+            x_expand: true,
+        });
+        this._locationLabel = new St.Label({
+            style_class: 'shell-widget-solar-location',
+            x_align: Clutter.ActorAlign.END,
+        });
+        this._locationLabel.clutter_text.ellipsize = Pango.EllipsizeMode.END;
+        this._locationLabel.clutter_text.single_line_mode = true;
+        header.add_child(this._titleLabel);
+        header.add_child(this._locationLabel);
+        this.add_child(header);
+
+        this._statusLabel = new St.Label({
+            style_class: 'shell-widget-solar-status',
+            x_align: Clutter.ActorAlign.START,
+        });
+        this.add_child(this._statusLabel);
+
+        const progress = new St.BoxLayout({
+            style_class: 'shell-widget-solar-progress',
+            x_expand: true,
+        });
+        this._progressSegments = [];
+        for (let i = 0; i < SOLAR_PROGRESS_SEGMENTS; i++) {
+            const segment = new St.Widget({
+                style_class: 'shell-widget-solar-progress-segment',
+                y_align: Clutter.ActorAlign.CENTER,
+                x_expand: true,
+                y_expand: false,
+            });
+            this._progressSegments.push(segment);
+            progress.add_child(segment);
+        }
+        this.add_child(progress);
+
+        const metrics = new St.BoxLayout({
+            style_class: 'shell-widget-solar-metrics',
+            x_expand: true,
+        });
+        [this._sunriseValue] = this._addMetric(
+            metrics, _('Sunrise'), 'sunrise');
+        [this._daylightValue] = this._addMetric(
+            metrics, _('Daylight'), 'daylight');
+        [this._sunsetValue] = this._addMetric(
+            metrics, _('Sunset'), 'sunset');
+        this.add_child(metrics);
+
+        this._weatherChangedId = this._weatherClient.connect('changed',
+            () => this.update());
+        this.connect('destroy', () => {
+            if (this._weatherChangedId) {
+                this._weatherClient.disconnect(this._weatherChangedId);
+                this._weatherChangedId = 0;
+            }
+        });
+    }
+
+    _addMetric(parent, title, styleClass) {
+        const box = new St.BoxLayout({
+            style_class: `shell-widget-solar-metric ${styleClass}`,
+            orientation: Clutter.Orientation.VERTICAL,
+            x_expand: true,
+        });
+        const titleLabel = new St.Label({
+            style_class: 'shell-widget-solar-metric-title',
+            text: title,
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        const valueLabel = new St.Label({
+            style_class: 'shell-widget-solar-metric-value',
+            x_align: Clutter.ActorAlign.CENTER,
+        });
+        box.add_child(titleLabel);
+        box.add_child(valueLabel);
+        parent.add_child(box);
+        return [valueLabel, box];
+    }
+
+    _locationDateKey(location) {
+        const timezone = location.get_timezone();
+        const now = timezone
+            ? GLib.DateTime.new_now(timezone)
+            : GLib.DateTime.new_now_local();
+        return `${now.get_year()}-${now.get_month()}-${now.get_day_of_month()}`;
+    }
+
+    _syncSolarInfo() {
+        if (!this._weatherClient.hasLocation)
+            return false;
+
+        const location = this._weatherClient.info.location;
+        if (!location)
+            return false;
+
+        const dateKey = this._locationDateKey(location);
+        const locationChanged = !this._solarLocation ||
+            !this._solarLocation.equal(location);
+        if (this._solarInfo && !locationChanged &&
+            dateKey === this._solarDateKey)
+            return true;
+
+        this._solarInfo = new GWeather.Info({
+            application_id: 'org.gnome.Shell',
+            contact_info:
+                'https://gitlab.gnome.org/GNOME/gnome-shell/-/raw/HEAD/gnome-shell.doap',
+            enabled_providers: GWeather.Provider.NONE,
+        });
+        this._solarInfo.set_location(location);
+        this._solarLocation = location;
+        this._solarDateKey = dateKey;
+        return true;
+    }
+
+    _formatSolarTime(timestamp) {
+        let dateTime = GLib.DateTime.new_from_unix_utc(timestamp);
+        const timezone = this._solarLocation?.get_timezone();
+        if (timezone)
+            dateTime = dateTime.to_timezone(timezone);
+        return formatTime(dateTime, {timeOnly: true});
+    }
+
+    _formatDuration(milliseconds) {
+        const totalMinutes = Math.max(0,
+            Math.round(milliseconds / (60 * 1000)));
+        const hours = Math.floor(totalMinutes / 60);
+        const minutes = totalMinutes % 60;
+
+        if (hours === 0)
+            return _('%d min').format(minutes);
+        if (minutes === 0)
+            return _('%d hr').format(hours);
+        return _('%d hr %d min').format(hours, minutes);
+    }
+
+    _setProgress(progress, isDaytime) {
+        const currentSegment = isDaytime
+            ? Math.min(SOLAR_PROGRESS_SEGMENTS - 1,
+                Math.floor(progress * SOLAR_PROGRESS_SEGMENTS))
+            : -1;
+
+        this._progressSegments.forEach((segment, index) => {
+            segment.remove_style_class_name('elapsed');
+            segment.remove_style_class_name('current');
+
+            if (progress >= 1 || index < currentSegment)
+                segment.add_style_class_name('elapsed');
+            else if (index === currentSegment)
+                segment.add_style_class_name('current');
+        });
+    }
+
+    _setUnavailable() {
+        this._locationLabel.text = _('Set a weather location');
+        this._statusLabel.text = _('Sun times unavailable');
+        this._sunriseValue.text = '—';
+        this._daylightValue.text = '—';
+        this._sunsetValue.text = '—';
+        this._setProgress(0, false);
+    }
+
+    update() {
+        if (!this._weatherClient || !this._syncSolarInfo()) {
+            this._setUnavailable();
+            return;
+        }
+
+        const [sunriseValid, sunrise] =
+            this._solarInfo.get_value_sunrise();
+        const [sunsetValid, sunset] =
+            this._solarInfo.get_value_sunset();
+        if (!sunriseValid || !sunsetValid || sunset <= sunrise) {
+            this._setUnavailable();
+            return;
+        }
+
+        const now = Date.now();
+        const sunriseMs = sunrise * 1000;
+        const sunsetMs = sunset * 1000;
+        const daylightMs = sunsetMs - sunriseMs;
+        const locationName = this._solarLocation.get_city_name() ||
+            this._solarLocation.get_name() || _('Current Location');
+
+        this._locationLabel.text = locationName;
+        this._sunriseValue.text = this._formatSolarTime(sunrise);
+        this._daylightValue.text = this._formatDuration(daylightMs);
+        this._sunsetValue.text = this._formatSolarTime(sunset);
+
+        if (now < sunriseMs) {
+            this._statusLabel.text = _('Night · Sunrise in %s')
+                .format(this._formatDuration(sunriseMs - now));
+            this._setProgress(0, false);
+        } else if (now < sunsetMs) {
+            const progress = (now - sunriseMs) / daylightMs;
+            this._statusLabel.text = _('Daylight · %s left')
+                .format(this._formatDuration(sunsetMs - now));
+            this._setProgress(progress, true);
+        } else {
+            this._statusLabel.text = _('Night · Sunset was at %s')
+                .format(this._formatSolarTime(sunset));
+            this._setProgress(1, false);
+        }
+    }
+});
+
+registerWidget(SolarWidget.id, context => new SolarWidget(context), {
+    title: SolarWidget.title,
+    preferredHeight: SolarWidget.preferredHeight,
+    defaultRefreshInterval: SolarWidget.defaultRefreshInterval,
+});
