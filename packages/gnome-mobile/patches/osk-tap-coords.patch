+    // fajita: emit a tapped key's quantized grid coords to the engine as
+    // press-only PUA key events. Tap-coordinate protocol: ROW marker
+    // U+F820+qrow first, then COL marker U+F860+qcol. Same-connection
+    // ordering guarantees ROW arrives before COL.
+    injectTapCoords(qcol, qrow) {
+        if (!this._context)
+            return;
+        const pua = cp => 0x01000000 | cp;
+        const row = pua(0xF820 + (qrow | 0)); // ROW marker
+        const col = pua(0xF860 + (qcol | 0)); // COL marker
+        // Fire press-only, detach the returned promises so a failed marker
+        // never disturbs typing (same connection = ordered delivery).
+        this._context.process_key_event_async(row, 0, 0, -1, null)
+            .catch(() => {});
+        this._context.process_key_event_async(col, 0, 0, -1, null)
+            .catch(() => {});
+    }
