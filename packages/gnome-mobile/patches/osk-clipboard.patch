diff --git a/js/misc/clipboardHistory.js b/js/misc/clipboardHistory.js
new file mode 100644
index 000000000..da8048d0f
--- /dev/null
+++ b/js/misc/clipboardHistory.js
@@ -0,0 +1,163 @@
+// clipboardHistory.js
+//
+// Pure, framework-free clipboard-history model. Deliberately free of any
+// gi:// imports so it can be re-platformed (tests, other shells) later. All
+// GNOME/Clutter/GLib glue lives in ui/clipboardManager.js.
+
+export const TERMINAL_APP_IDS = new Set([
+    'org.gnome.Console',
+    'org.gnome.Ptyxis',
+    'io.matv.Relay',
+]);
+
+export function isTerminalAppId(id) {
+    return !!id && TERMINAL_APP_IDS.has(id);
+}
+
+// Max unpinned entries retained; pinned entries are exempt from this cap.
+export const HISTORY_CAP = 20;
+
+// Secret markers checked (case-insensitively, as substrings) against every
+// mimetype string so password-manager clips (Warden/Bitwarden/KDE) never
+// enter history.
+const SECRET_MARKERS = [
+    'x-kde-passwordmanagerhint',
+    'application/x-secret',
+    'x-kde-password',
+    'password',
+];
+
+export function shouldSkipClipboard(mimetypes, text) {
+    // Empty / whitespace-only / null → skip.
+    if (text === null || text === undefined)
+        return true;
+    if (String(text).trim() === '')
+        return true;
+
+    // Secret markers → skip. Null-safe: non-array is treated as empty.
+    const mimes = Array.isArray(mimetypes) ? mimetypes : [];
+    for (const mime of mimes) {
+        if (mime === null || mime === undefined)
+            continue;
+        const lower = String(mime).toLowerCase();
+        for (const marker of SECRET_MARKERS) {
+            if (lower.includes(marker))
+                return true;
+        }
+    }
+
+    return false;
+}
+
+export class ClipboardHistory {
+    constructor() {
+        // Each item: { text, pinned, ts } where ts is epoch milliseconds.
+        this._items = [];
+    }
+
+    add(text, ts = Date.now()) {
+        if (text === null || text === undefined)
+            return;
+        if (String(text).trim() === '')
+            return;
+
+        // Exact-string dedup: pull any existing entry with the same text,
+        // preserving its pinned flag, then re-insert fresh at the top.
+        let preservedPinned = false;
+        const idx = this._items.findIndex(i => i.text === text);
+        if (idx !== -1) {
+            preservedPinned = !!this._items[idx].pinned;
+            this._items.splice(idx, 1);
+        }
+
+        this._items.unshift({ text, pinned: preservedPinned || false, ts });
+
+        // Trim: keep ALL pinned items (exempt from cap) plus at most
+        // HISTORY_CAP newest unpinned items. Drop the oldest unpinned beyond
+        // the cap without reordering anything else.
+        let unpinnedSeen = 0;
+        this._items = this._items.filter(item => {
+            if (item.pinned)
+                return true;
+            unpinnedSeen++;
+            return unpinnedSeen <= HISTORY_CAP;
+        });
+    }
+
+    togglePin(text) {
+        const item = this._items.find(i => i.text === text);
+        if (!item)
+            return undefined;
+        item.pinned = !item.pinned;
+        return item.pinned;
+    }
+
+    remove(text) {
+        const idx = this._items.findIndex(i => i.text === text);
+        if (idx !== -1)
+            this._items.splice(idx, 1);
+    }
+
+    clear() {
+        // Remove all unpinned items; keep pinned.
+        this._items = this._items.filter(i => i.pinned);
+    }
+
+    // fajita: Phase 3 — drop unpinned entries older than maxAgeMs (pinned are
+    // exempt). Called on panel-open so stale clips auto-clear (~1 h). A missing
+    // or non-finite ts is treated as fresh (kept) so legacy entries survive.
+    purge(maxAgeMs) {
+        if (!Number.isFinite(maxAgeMs) || maxAgeMs <= 0)
+            return;
+        const cutoff = Date.now() - maxAgeMs;
+        this._items = this._items.filter(item => {
+            if (item.pinned)
+                return true;
+            if (!Number.isFinite(item.ts))
+                return true;
+            return item.ts >= cutoff;
+        });
+    }
+
+    items() {
+        // New array, pinned-first (existing relative order), then unpinned
+        // (existing relative order). Internal state is not mutated.
+        const pinned = this._items.filter(i => i.pinned);
+        const unpinned = this._items.filter(i => !i.pinned);
+        return [...pinned, ...unpinned];
+    }
+
+    get length() {
+        return this._items.length;
+    }
+
+    toJSON() {
+        return {
+            version: 1,
+            items: this._items.map(i => ({
+                text: i.text,
+                pinned: !!i.pinned,
+                ts: i.ts,
+            })),
+        };
+    }
+
+    static fromJSON(obj) {
+        const history = new ClipboardHistory();
+        if (!obj || !Array.isArray(obj.items))
+            return history;
+
+        for (const raw of obj.items) {
+            if (!raw || typeof raw.text !== 'string')
+                continue;
+            const ts = Number.isFinite(raw.ts) ? raw.ts : Date.now();
+            history._items.push({
+                text: raw.text,
+                pinned: !!raw.pinned,
+                ts,
+            });
+        }
+
+        return history;
+    }
+}
diff --git a/js/ui/clipboardManager.js b/js/ui/clipboardManager.js
new file mode 100644
index 000000000..025080509
--- /dev/null
+++ b/js/ui/clipboardManager.js
@@ -0,0 +1,356 @@
+// clipboardManager.js
+//
+// GNOME Shell glue around the pure ClipboardHistory model. Owns the
+// St.Clipboard, the owner-changed watch, the virtual keyboard device used to
+// inject copy/paste/cut chords into the focused app, and persistence.
+//
+// CRASH SAFETY: every public method and every callback is guarded so nothing
+// throws out into the shell. The keyboard must keep working even if any
+// clipboard op fails.
+
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import Meta from 'gi://Meta';
+import St from 'gi://St';
+import * as ClipboardHistoryModule from '../misc/clipboardHistory.js';
+
+let _default = null;
+
+export function getDefault() {
+    if (!_default)
+        _default = new ClipboardManager();
+    return _default;
+}
+
+class ClipboardManager {
+    constructor() {
+        this._clipboard = St.Clipboard.get_default();
+        this._history = new ClipboardHistoryModule.ClipboardHistory();
+        this._loadHistory();
+        this._lastSetByUs = null;
+        this._vdev = null;
+        this._saveTimeoutId = 0;
+        this._hasContent = false;
+
+        try {
+            this._selection = global.display.get_selection();
+            this._ownerChangedId = this._selection.connect('owner-changed',
+                this._onOwnerChanged.bind(this));
+        } catch (e) {
+            console.warn(`clipboardManager: owner-changed connect: ${e}`);
+        }
+
+        // Prime _hasContent from whatever is already on the clipboard.
+        try {
+            this.readCurrent(() => {});
+        } catch (e) {
+            console.warn(`clipboardManager: initial readCurrent: ${e}`);
+        }
+    }
+
+    _ensureVdev() {
+        if (this._vdev)
+            return this._vdev;
+        try {
+            const seat = global.stage.context.get_backend().get_default_seat();
+            this._vdev = seat.create_virtual_device(
+                Clutter.InputDeviceType.KEYBOARD_DEVICE);
+        } catch (e) {
+            console.warn(`clipboardManager: _ensureVdev: ${e}`);
+            this._vdev = null;
+        }
+        return this._vdev;
+    }
+
+    _sendChord(mods, keyval) {
+        const vdev = this._ensureVdev();
+        if (!vdev)
+            return;
+        try {
+            const t = () => Clutter.get_current_event_time() * 1000; // µs
+            for (const m of mods)
+                vdev.notify_keyval(t(), m, Clutter.KeyState.PRESSED);
+            vdev.notify_keyval(t(), keyval, Clutter.KeyState.PRESSED);
+            vdev.notify_keyval(t(), keyval, Clutter.KeyState.RELEASED);
+            for (const m of [...mods].reverse())
+                vdev.notify_keyval(t(), m, Clutter.KeyState.RELEASED);
+        } catch (e) {
+            console.warn(`clipboardManager: _sendChord: ${e}`);
+        }
+    }
+
+    _focusIsTerminal() {
+        try {
+            const w = global.display.focus_window;
+            const id = w && (w.get_gtk_application_id?.() ||
+                w.get_sandboxed_app_id?.() || w.get_wm_class?.());
+            return ClipboardHistoryModule.isTerminalAppId(id);
+        } catch (e) {
+            return false;
+        }
+    }
+
+    paste() {
+        try {
+            if (this._focusIsTerminal())
+                this._sendChord([Clutter.KEY_Control_L, Clutter.KEY_Shift_L], Clutter.KEY_v);
+            else
+                this._sendChord([Clutter.KEY_Control_L], Clutter.KEY_v);
+        } catch (e) {
+            console.warn(`clipboardManager: paste: ${e}`);
+        }
+    }
+
+    copy() {
+        try {
+            if (this._focusIsTerminal())
+                this._sendChord([Clutter.KEY_Control_L, Clutter.KEY_Shift_L], Clutter.KEY_c);
+            else
+                this._sendChord([Clutter.KEY_Control_L], Clutter.KEY_c);
+        } catch (e) {
+            console.warn(`clipboardManager: copy: ${e}`);
+        }
+    }
+
+    cut() {
+        try {
+            if (this._focusIsTerminal())
+                this._sendChord([Clutter.KEY_Control_L, Clutter.KEY_Shift_L], Clutter.KEY_x);
+            else
+                this._sendChord([Clutter.KEY_Control_L], Clutter.KEY_x);
+        } catch (e) {
+            console.warn(`clipboardManager: cut: ${e}`);
+        }
+    }
+
+    selectAll() {
+        try {
+            this._sendChord([Clutter.KEY_Control_L], Clutter.KEY_a);
+        } catch (e) {
+            console.warn(`clipboardManager: selectAll: ${e}`);
+        }
+    }
+
+    extendLeft() {
+        try {
+            this._sendChord([Clutter.KEY_Shift_L], Clutter.KEY_Left);
+        } catch (e) {
+            console.warn(`clipboardManager: extendLeft: ${e}`);
+        }
+    }
+
+    extendRight() {
+        try {
+            this._sendChord([Clutter.KEY_Shift_L], Clutter.KEY_Right);
+        } catch (e) {
+            console.warn(`clipboardManager: extendRight: ${e}`);
+        }
+    }
+
+    // fajita: Phase 2 edit bar — plain caret movement (no modifier), used when
+    // the edit-bar Select toggle is OFF. With Select ON the bar calls
+    // extendLeft()/extendRight() instead (Shift+Arrow).
+    moveLeft() {
+        try {
+            this._sendChord([], Clutter.KEY_Left);
+        } catch (e) {
+            console.warn(`clipboardManager: moveLeft: ${e}`);
+        }
+    }
+
+    moveRight() {
+        try {
+            this._sendChord([], Clutter.KEY_Right);
+        } catch (e) {
+            console.warn(`clipboardManager: moveRight: ${e}`);
+        }
+    }
+
+    // fajita: word-level caret jumps — Ctrl+Arrow. Used by the edit-bar arrow
+    // auto-repeat once a hold escalates from character to word granularity.
+    moveWordLeft() {
+        try {
+            this._sendChord([Clutter.KEY_Control_L], Clutter.KEY_Left);
+        } catch (e) {
+            console.warn(`clipboardManager: moveWordLeft: ${e}`);
+        }
+    }
+
+    moveWordRight() {
+        try {
+            this._sendChord([Clutter.KEY_Control_L], Clutter.KEY_Right);
+        } catch (e) {
+            console.warn(`clipboardManager: moveWordRight: ${e}`);
+        }
+    }
+
+    // fajita: word-level selection extend — Ctrl+Shift+Arrow.
+    extendWordLeft() {
+        try {
+            this._sendChord([Clutter.KEY_Control_L, Clutter.KEY_Shift_L], Clutter.KEY_Left);
+        } catch (e) {
+            console.warn(`clipboardManager: extendWordLeft: ${e}`);
+        }
+    }
+
+    extendWordRight() {
+        try {
+            this._sendChord([Clutter.KEY_Control_L, Clutter.KEY_Shift_L], Clutter.KEY_Right);
+        } catch (e) {
+            console.warn(`clipboardManager: extendWordRight: ${e}`);
+        }
+    }
+
+    pasteText(text) {
+        try {
+            if (text === null || text === undefined || text === '')
+                return;
+            this._lastSetByUs = text;
+            this._clipboard.set_text(St.ClipboardType.CLIPBOARD, text);
+            this.paste();
+        } catch (e) {
+            console.warn(`clipboardManager: pasteText: ${e}`);
+        }
+    }
+
+    readCurrent(cb) {
+        try {
+            this._clipboard.get_text(St.ClipboardType.CLIPBOARD, (_c, text) => {
+                try {
+                    this._hasContent = !!(text && text.trim() !== '');
+                } catch (e) {}
+                if (cb) {
+                    try {
+                        cb(text);
+                    } catch (e) {
+                        console.warn(`clipboardManager: readCurrent cb: ${e}`);
+                    }
+                }
+            });
+        } catch (e) {
+            console.warn(`clipboardManager: readCurrent: ${e}`);
+            if (cb) {
+                try {
+                    cb(null);
+                } catch (e2) {
+                    console.warn(`clipboardManager: readCurrent cb: ${e2}`);
+                }
+            }
+        }
+    }
+
+    hasContent() {
+        return this._hasContent;
+    }
+
+    get history() {
+        return this._history;
+    }
+
+    _onOwnerChanged(_sel, type, _source) {
+        try {
+            if (type !== Meta.SelectionType.SELECTION_CLIPBOARD)
+                return;
+
+            let mimetypes = [];
+            try {
+                mimetypes = this._clipboard.get_mimetypes(St.ClipboardType.CLIPBOARD) || [];
+            } catch (e) {
+                mimetypes = [];
+            }
+
+            this._clipboard.get_text(St.ClipboardType.CLIPBOARD, (_c, text) => {
+                try {
+                    this._ingest(mimetypes, text);
+                } catch (e) {
+                    console.warn(`clipboardManager: ingest: ${e}`);
+                }
+            });
+        } catch (e) {
+            console.warn(`clipboardManager: _onOwnerChanged: ${e}`);
+        }
+    }
+
+    _ingest(mimetypes, text) {
+        this._hasContent = !!(text && text.trim() !== '');
+
+        // Self-write guard: do NOT re-ingest our own pasteText() write.
+        if (text === this._lastSetByUs) {
+            this._lastSetByUs = null;
+            return;
+        }
+
+        if (ClipboardHistoryModule.shouldSkipClipboard(mimetypes, text))
+            return;
+
+        this._history.add(text);
+        this._scheduleSave();
+    }
+
+    _historyPath() {
+        return GLib.build_filenamev([
+            GLib.get_user_data_dir(), 'gnome-shell', 'fajita-clipboard.json']);
+    }
+
+    _loadHistory() {
+        try {
+            const path = this._historyPath();
+            const file = Gio.File.new_for_path(path);
+            const [ok, contents] = file.load_contents(null);
+            if (!ok)
+                return;
+            const text = new TextDecoder().decode(contents);
+            const parsed = JSON.parse(text);
+            this._history = ClipboardHistoryModule.ClipboardHistory.fromJSON(parsed);
+        } catch (e) {
+            // Missing file / parse failure is normal on first run; keep the
+            // empty instance and stay quiet.
+            console.debug(`clipboardManager: _loadHistory: ${e}`);
+        }
+    }
+
+    _scheduleSave() {
+        try {
+            if (this._saveTimeoutId) {
+                GLib.source_remove(this._saveTimeoutId);
+                this._saveTimeoutId = 0;
+            }
+            this._saveTimeoutId = GLib.timeout_add(
+                GLib.PRIORITY_DEFAULT, 500, () => {
+                    this._saveTimeoutId = 0;
+                    this._saveHistory();
+                    return GLib.SOURCE_REMOVE;
+                });
+        } catch (e) {
+            console.warn(`clipboardManager: _scheduleSave: ${e}`);
+        }
+    }
+
+    _saveHistory() {
+        try {
+            const json = JSON.stringify(this._history.toJSON());
+            const file = Gio.File.new_for_path(this._historyPath());
+
+            const dir = file.get_parent();
+            try {
+                dir.make_directory_with_parents(null);
+            } catch (e) {
+                // Directory already exists — fine.
+            }
+
+            const bytes = new GLib.Bytes(new TextEncoder().encode(json));
+            file.replace_contents_bytes_async(bytes, null, false,
+                Gio.FileCreateFlags.REPLACE_DESTINATION, null,
+                (obj, res) => {
+                    try {
+                        obj.replace_contents_finish(res);
+                    } catch (e) {
+                        console.warn(`clipboardManager: save failed: ${e}`);
+                    }
+                });
+        } catch (e) {
+            console.warn(`clipboardManager: _saveHistory: ${e}`);
+        }
+    }
