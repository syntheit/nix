@@ -161,3 +161,131 @@ $default_key_bg_color: if($variant=='light', darken($key_bg_color, 11%), darken(
     &:checked { @include button(checked, $c:$key_bg_color, $tc:$osd_fg_color); }
   }
 }
+
+// fajita: clipboard/edit icon buttons on the suggestion row + edit bar.
+// Symbolic St.Icons auto-recolor to fg (monochrome). Compact, centered.
+.word-suggestion-paste,
+.word-suggestion-clip,
+.word-suggestion-edit {
+  color: $osd_fg_color;
+  border-radius: $base_border_radius - 2px;
+  padding: 4px 8px;
+  @include button(undecorated, $c:$key_bg_color, $tc:$osd_fg_color);
+  &:hover { @include button(hover, $c:$key_bg_color, $tc:$osd_fg_color); }
+  &:active { @include button(active, $c:$key_bg_color, $tc:$osd_fg_color); }
+  // when edit mode is on, the edit toggle stays visibly pressed
+  &.active { @include button(checked, $c:$key_bg_color, $tc:$osd_fg_color); }
+
+  .word-suggestion-icon { icon-size: 1.25em; }
+}
+
+// fajita: edit bar — evenly spaced symbolic buttons; the Select toggle's ON
+// state (.selected) gets a distinct accent background.
+.word-suggestions-editbar {
+  spacing: 2px;
+  padding-left: 4px;
+  padding-right: 4px;
+
+  .edit-key {
+    color: $osd_fg_color;
+    border-radius: $base_border_radius - 2px;
+    padding: 4px 6px;
+    @include button(undecorated, $c:$key_bg_color, $tc:$osd_fg_color);
+    &:hover { @include button(hover, $c:$key_bg_color, $tc:$osd_fg_color); }
+    &:active { @include button(active, $c:$key_bg_color, $tc:$osd_fg_color); }
+
+    .edit-key-icon { icon-size: 1.25em; }
+  }
+
+  // Select toggle ON — accent-filled so it's clearly distinct from OFF.
+  .edit-key-toggle.selected {
+    background-color: -st-accent-color;
+    color: -st-accent-fg-color;
+    &:hover { background-color: st-lighten(-st-accent-color, 5%); }
+    &:active { background-color: st-lighten(-st-accent-color, 5%); }
+  }
+}
+
+// fajita: clip-panel icon buttons (close/pin/delete) recolor to fg.
+.clipboard-card-icon { icon-size: 1.125em; }
+
+// fajita: Phase 3 — clipboard-history panel (Gboard-style). Bounded heights
+// only; the scroll view is height-clamped so it can never drive an unbounded
+// or NaN allocation into the key area.
+.clipboard-panel {
+  spacing: 6px;
+  padding: 6px 8px;
+
+  .clipboard-panel-header {
+    spacing: 8px;
+    padding: 2px 2px 4px 2px;
+
+    .clipboard-panel-title {
+      @extend %title_4;
+      color: $osd_fg_color;
+      font-weight: bold;
+    }
+
+    .clipboard-panel-close {
+      color: $osd_fg_color;
+      border-radius: $base_border_radius;
+      padding: 2px 10px;
+      @include button(undecorated, $c:$key_bg_color, $tc:$osd_fg_color);
+      &:hover { @include button(hover, $c:$key_bg_color, $tc:$osd_fg_color); }
+      &:active { @include button(active, $c:$key_bg_color, $tc:$osd_fg_color); }
+    }
+  }
+
+  .clipboard-panel-scroll {
+    height: 180px;
+  }
+
+  .clipboard-panel-list {
+    spacing: 4px;
+    padding-right: 4px;
+  }
+
+  .clipboard-section-label {
+    @extend %caption;
+    color: transparentize($osd_fg_color, 0.4);
+    font-weight: bold;
+    padding: 4px 2px 2px 2px;
+  }
+
+  .clipboard-panel-empty {
+    color: transparentize($osd_fg_color, 0.4);
+    padding: 24px;
+  }
+
+  .clipboard-card {
+    spacing: 4px;
+    border-radius: $base_border_radius;
+    background-color: transparentize($key_bg_color, 0.4);
+    padding: 2px 4px;
+
+    &.clipboard-card-pinned {
+      background-color: transparentize($key_bg_color, 0.15);
+    }
+
+    .clipboard-card-preview {
+      color: $osd_fg_color;
+      padding: 6px 8px;
+      border-radius: $base_border_radius - 2px;
+      &:hover { @include button(hover, $c:$key_bg_color, $tc:$osd_fg_color); }
+      &:active { @include button(active, $c:$key_bg_color, $tc:$osd_fg_color); }
+    }
+
+    .clipboard-card-text {
+      color: $osd_fg_color;
+    }
+
+    .clipboard-card-pin-btn,
+    .clipboard-card-delete {
+      color: $osd_fg_color;
+      padding: 4px 8px;
+      border-radius: $base_border_radius - 2px;
+      &:hover { @include button(hover, $c:$key_bg_color, $tc:$osd_fg_color); }
+      &:active { @include button(active, $c:$key_bg_color, $tc:$osd_fg_color); }
+    }
+  }
+}
