+    allowsQuickSettingsPan(gesture) {
+        const beginCoords = gesture.get_begin_centroid_abs();
+        if (!this.get_transformed_extents().contains_point(beginCoords))
+            return true;
+
+        const coords = gesture.get_centroid_abs();
+        const delta = coords.y - beginCoords.y;
+        const adj = this._scrollView.vadjustment;
+
+        // Keep scrollable notification motion in the message list. At either
+        // edge, hand outward motion to the containing quick-settings shade.
+        const end = Math.max(adj.upper - adj.page_size, adj.lower);
+        const epsilon = 0.5;
+        if (delta < 0)
+            return adj.value >= end - epsilon;
+        if (delta > 0)
+            return adj.value <= adj.lower + epsilon;
+
+        return false;
+    }
