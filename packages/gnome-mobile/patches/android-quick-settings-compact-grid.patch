+const NMHotspotToggle = GObject.registerClass(
+class NMHotspotToggle extends QuickToggle {
+    constructor() {
+        super({
+            title: _('Hotspot'),
+            iconName: 'network-wireless-hotspot-symbolic',
+            toggle_mode: true,
+        });
+
+        this.connect('clicked', () => this.activate());
+    }
+
+    setClient(client) {
+        if (this._client === client)
+            return;
+
+        this._client?.disconnectObject(this);
+        this._device?.disconnectObject(this);
+        this._client = client;
+        this._device = null;
+
+        this._client?.connectObject(
+            'device-added', () => this._syncDevice(),
+            'device-removed', () => this._syncDevice(),
+            'notify::active-connections', () => this._sync(),
+            'notify::wireless-enabled', () => this._sync(),
+            this);
+        this._syncDevice();
+    }
+
+    _syncDevice() {
+        const device = this._client?.get_devices()
+            .find(candidate =>
+                candidate.device_type === NM.DeviceType.WIFI) ?? null;
+        if (this._device === device) {
+            this._sync();
+            return;
+        }
+
+        this._device?.disconnectObject(this);
+        this._device = device;
+        this._device?.connectObject(
+            'notify::active-connection', () => this._sync(),
+            'state-changed', () => this._sync(),
+            this);
+        this._sync();
+    }
+
+    _isHotspotConnection(connection) {
+        if (!connection)
+            return false;
+
+        const wireless = connection.get_setting_wireless();
+        const ip4 = connection.get_setting_ip4_config();
+        return ['ap', 'adhoc'].includes(wireless?.get_mode()) &&
+            ip4?.get_method() === NM.SETTING_IP4_CONFIG_METHOD_SHARED;
+    }
+
+    _getActiveHotspot() {
+        const active = this._device?.active_connection ?? null;
+        return this._isHotspotConnection(active?.connection)
+            ? active
+            : null;
+    }
+
+    _getSavedHotspot() {
+        return this._client?.get_connections()
+            .find(connection => this._isHotspotConnection(connection)) ?? null;
+    }
+
+    activate() {
+        const active = this._getActiveHotspot();
+        if (active) {
+            this._client.deactivate_connection_async(active, null, null);
+            return;
+        }
+
+        const connection = this._getSavedHotspot();
+        if (connection && this._device) {
+            this._client.activate_connection_async(
+                connection, this._device, null, null, null);
+            return;
+        }
+
+        PopupMenu.launchApplication(
+            'gnome-wifi-panel.desktop',
+            'org.gnome.Settings.desktop');
+        this._sync();
+    }
+
+    _sync() {
+        this.visible = !!this._client && !!this._device;
+        this.reactive = this.visible && this._client.wireless_enabled;
+        this.checked = this._getActiveHotspot() !== null;
+    }
+});
