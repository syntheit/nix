+// Compact toggles need symmetric padding. The normal LTR and menu rules above
+// deliberately bias text pills toward their leading edge; without this final
+// override an icon-only tile is visibly shifted to the right.
+.quick-toggle.quick-toggle-compact:ltr > StBoxLayout,
+.quick-toggle.quick-toggle-compact:rtl > StBoxLayout,
+.quick-toggle-has-menu.quick-toggle-compact .quick-toggle.quick-toggle-compact:ltr > StBoxLayout,
+.quick-toggle-has-menu.quick-toggle-compact .quick-toggle.quick-toggle-compact:rtl > StBoxLayout {
+  padding-left: $base_padding;
+  padding-right: $base_padding;
+  spacing: 0;
+}
