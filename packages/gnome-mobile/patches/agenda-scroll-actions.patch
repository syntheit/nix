+    _panMayRecognize(gesture) {
+        const adjustment = this._scrollView.vadjustment;
+        if (!adjustment || adjustment.upper <= adjustment.page_size)
+            return false;
+
+        const beginCoords = gesture.get_begin_centroid_abs();
+        if (!this._scrollView.get_transformed_extents().contains_point(beginCoords))
+            return true;
+
+        const coords = gesture.get_centroid_abs();
+        const delta = coords.y - beginCoords.y;
+        const end = adjustment.upper - adjustment.page_size;
+        const epsilon = 0.5;
+
+        // At either end, let another gesture win instead of trapping the
+        // sequence in a timeline that cannot move any farther.
+        if (delta < 0 && adjustment.value >= end - epsilon)
+            return false;
+        if (delta > 0 && adjustment.value <= adjustment.lower + epsilon)
+            return false;
+
+        return true;
+    }
+
+    _onPanUpdate(gesture) {
+        const delta = gesture.get_delta();
+        const adjustment = this._scrollView.vadjustment;
+        const height = Math.max(this._scrollView.height, 1);
+        adjustment.value -= delta.get_y() / height * adjustment.page_size;
+    }
+
+    _calendarApp() {
+        const apps = Gio.AppInfo.get_recommended_for_type('text/calendar');
+        if (!apps || apps.length === 0)
+            return null;
+
+        const defaultApp = Gio.AppInfo.get_default_for_type(
+            'text/calendar', false);
+        if (defaultApp && apps.some(app => app.equal(defaultApp)))
+            return defaultApp;
+
+        return apps[0];
+    }
+
+    _launchCalendar(args = []) {
+        const appInfo = this._calendarApp();
+        if (!appInfo)
+            return;
+
+        // GNOME Calendar exposes exact date/event opening through its command
+        // line. Other calendar apps still get a normal launch fallback.
+        if (args.length > 0 &&
+            appInfo.get_id() === 'org.gnome.Calendar.desktop') {
+            const executable = appInfo.get_executable();
+            if (executable) {
+                try {
+                    Gio.Subprocess.new([executable, ...args],
+                        Gio.SubprocessFlags.NONE);
+                    return;
+                } catch (error) {
+                    console.error('Failed to launch GNOME Calendar:', error);
+                }
+            }
+        }
+
+        try {
+            appInfo.launch([], global.create_app_launch_context(0, -1));
+        } catch (error) {
+            console.error('Failed to launch calendar application:', error);
+        }
+    }
