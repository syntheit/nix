+    _openDate(date) {
+        if (!(date instanceof Date) || !Number.isFinite(date.getTime()))
+            return;
+
+        const year = `${date.getFullYear()}`.padStart(4, '0');
+        const month = `${date.getMonth() + 1}`.padStart(2, '0');
+        const day = `${date.getDate()}`.padStart(2, '0');
+        this._launchCalendar(['--date', `${year}-${month}-${day}`]);
+    }
+
+    _openEvent(event) {
+        const [sourceUid = '', eventUid = '', recurrenceId = ''] =
+            `${event?.id ?? ''}`.split('\n');
+        if (!sourceUid || !eventUid) {
+            this._launchCalendar();
+            return;
+        }
+
+        // Shell's calendar server separates source/UID/RID with newlines;
+        // GNOME Calendar's --uuid argument uses the same fields with colons.
+        const uuid = [sourceUid, eventUid, recurrenceId]
+            .filter(part => part.length > 0)
+            .join(':');
+        this._launchCalendar(['--uuid', uuid]);
