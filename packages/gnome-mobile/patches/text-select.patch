diff --git a/js/ui/textSelect.js b/js/ui/textSelect.js
new file mode 100644
index 000000000..8df3b764c
--- /dev/null
+++ b/js/ui/textSelect.js
@@ -0,0 +1,2334 @@
+// fajita: GLOBAL long-press-to-select-text-and-Copy for GNOME Shell Mobile 49.
+//
+// Fail-safe philosophy: a bug in this file could break tapping/scrolling across
+// the WHOLE phone. So every step is wrapped in try/catch that logs a
+// console.warn(...) and degrades to "do nothing". Nothing is ever allowed to
+// throw out of a signal handler or async callback. The gesture is ultra
+// conservative: it is a plain Clutter.LongPressGesture on the stage that we
+// NEVER mark can_not_cancel — so it yields to (is cancelled by) every app
+// scroll/pan and every shell swipe tracker. If in doubt, we no-op.
+
+import Clutter from 'gi://Clutter';
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+import Shell from 'gi://Shell';
+import St from 'gi://St';
+
+import * as Main from './main.js';
+import * as ClipboardManager from './clipboardManager.js';
+
+// fajita: KILL SWITCH — flip to false to disable the whole feature in one line.
+const TEXT_SELECT_ENABLED = true;
+// fajita: DIAGNOSTICS — when true, emit concise `textSelect:` traces to the
+// journal (gesture recognize + chosen backend, AT-SPI/OCR results, overlay
+// shown vs skipped). Never logs full copied text (privacy) — only lengths /
+// counts. Flip to false to silence.
+const TEXT_SELECT_DEBUG = true;
+
+const LONG_PRESS_MS = 550;          // still-hold duration to recognize
+const CANCEL_THRESHOLD_PX = 8;      // movement beyond this cancels (scroll wins)
+const HELPER_TIMEOUT_MS = 2500;     // per-helper watchdog; kill + no-op on timeout
+const PREVIEW_MAX = 48;             // chars of text shown in the Copy pill
+const WORD_SNAP_MAX_PX = 96;   // fajita: F7 — ~2 line-heights; nearest-word fallback beyond this = "no word"
+
+const OCR_HELPER_TIMEOUT_MS = 4000;
+const OCR_BAND_HALF_W = 480;
+const OCR_BAND_HALF_H = 260;
+const HANDLE_SIZE = 28;
+const HANDLE_HIT_SLOP = 22;
+
+// App ids where the feature must NOT fire (overview/app-grid/shell itself).
+// fajita: matched case-insensitively against the lowercased app id.
+const APP_ID_BLOCKLIST = new Set([
+    'org.gnome.shell',
+]);
+
+// Known web/Waydroid/Chromium ids that must ALWAYS use OCR (never AT-SPI).
+// fajita: lowercase substring/prefix fragments — an app id is OCR-only if its
+// lowercased id contains any of these (so com.android.*, firefox/Firefox/
+// org.mozilla.firefox, all chromium variants, waydroid all route to OCR).
+const OCR_ONLY_IDS = [
+    'firefox', 'mozilla',
+    'epiphany',
+    'chromium', 'chrome',
+    'waydroid', 'com.android', 'org.waydroid',
+    // fajita: Courier renders HTML mail bodies in WebKitGTK, so AT-SPI text
+    // extraction is unreliable there → force OCR. Matched case-insensitively
+    // as a substring, so this catches the app-id io.matv.Courier.
+    'io.matv.courier',
+];
+
+// fajita: AT-SPI CALIBRATION — the AT-SPI helper's coordinate space is an
+// unverified guess. This knob must be verified on the first on-device run
+// (does the copied text match the finger? is the highlight on the line?):
+//   • ATSPI_COORDS_PHYSICAL — best-guess for now. When true we send PHYSICAL
+//     (device-pixel) window-local coords to the helper and interpret returned
+//     boxes as physical (map back to logical with / scale). When false we
+//     treat everything as logical. FLIP THIS if the copied text / highlight is
+//     off by the display scale factor.
+const ATSPI_COORDS_PHYSICAL = false;
+
+export class TextSelectManager {
+    constructor() {
+        // fajita: initialize every field to a safe "nothing wired" state.
+        this._gesture = null;
+        this._recognizeId = 0;
+        this._mayRecognizeId = 0;
+        this._overlayActors = [];
+        this._overlaySignals = [];
+        this._cancellable = null;
+        this._timeoutId = 0;
+        this._inflightProc = null;   // fajita: F4 — force_exit()-able tracked helper proc
+        this._dismissTimeoutId = 0;  // fajita: F8 — defense-in-depth auto-dismiss timer
+        this._loadingWatchdogId = 0; // fajita: F2 — force-teardown if stuck in loading phase
+        this._lockedChangedId = 0;   // fajita: F3 — Main.screenShield 'locked-changed'
+        this._sessionUpdatedId = 0;  // fajita: F3 — Main.sessionMode 'updated'
+        // fajita: F2 — bumped on every teardown/disable/new-recognize so a late
+        // async helper result can't build an overlay after we've moved on.
+        this._generation = 0;
+        this._enabled = false;
+
+        this._phase = null;
+        this._words = [];
+        this._order = [];
+        this._orderPos = [];
+        this._selStart = 0;
+        this._selEnd = 0;
+        this._dragging = null;
+        this._selActors = [];
+        this._handleActors = [];
+        this._selectedText = '';
+        this._lastDragPos = -1;
+        this._noWordsTimeoutId = 0;
+        this._scrim = null;
+        this._loadingPill = null;
+        this._selPill = null;
+        this._startHandleCenter = null;
+        this._endHandleCenter = null;
+
+        // fajita: KILL SWITCH — do not wire ANYTHING if disabled.
+        if (!TEXT_SELECT_ENABLED)
+            return;
+
+        try {
+            this.enable();
+        } catch (e) {
+            console.warn(`textSelect: enable() threw, staying disabled: ${e}`);
+            try {
+                this.disable();
+            } catch (e2) {
+                console.warn(`textSelect: disable() after failed enable threw: ${e2}`);
+            }
+        }
+    }
+
+    enable() {
+        // fajita: guard the whole body; on any failure fail safe by disabling.
+        try {
+            // Promisify screenshot_area. Idempotent/harmless if already done,
+            // but wrap anyway so a double-promisify can never break us.
+            try {
+                Gio._promisify(Shell.Screenshot.prototype, 'screenshot_area');
+            } catch (e) {
+                console.warn(`textSelect: promisify screenshot_area failed: ${e}`);
+            }
+
+            // Prime the clipboard manager so its owner-changed watch is live and
+            // auto-ingests our set_text into clipboard history later.
+            try {
+                ClipboardManager.getDefault();
+            } catch (e) {
+                console.warn(`textSelect: priming ClipboardManager failed: ${e}`);
+            }
+
+            // fajita: a plain long-press gesture. We NEVER call can_not_cancel(),
+            // so the shell/app trackers freely cancel it — the conservative,
+            // yield-to-everything behavior we want. cancel_threshold gives us
+            // "still hold" for free: any movement past 8px cancels.
+            this._gesture = new Clutter.LongPressGesture({
+                long_press_duration_ms: LONG_PRESS_MS,
+                cancel_threshold: CANCEL_THRESHOLD_PX,
+                required_button: Clutter.BUTTON_PRIMARY,
+            });
+
+            // fajita: F3 — refuse to even reach RECOGNIZING outside normal/overview
+            // mode (lock screen, unlock dialog, system-modal dialogs), so the
+            // haptic + screenshot/OCR work never runs there. Returning false from
+            // may-recognize blocks the gesture (see switcherPopup.js pattern).
+            this._mayRecognizeId = this._gesture.connect('may-recognize', () => {
+                try {
+                    return !!(Main.actionMode &
+                        (Shell.ActionMode.NORMAL | Shell.ActionMode.OVERVIEW));
+                } catch (e) {
+                    console.warn(`textSelect: may-recognize predicate threw: ${e}`);
+                    return false;
+                }
+            });
+
+            this._recognizeId = this._gesture.connect('recognize', () => {
+                try {
+                    this._onRecognize();
+                } catch (e) {
+                    console.warn(`textSelect: _onRecognize threw: ${e}`);
+                }
+            });
+
+            global.stage.add_action(this._gesture);
+            this._enabled = true;
+
+            // fajita: F3 — tear the overlay down (and cancel in-flight OCR) the
+            // moment the session locks or the shell mode leaves NORMAL/OVERVIEW,
+            // so nothing we drew can sit above the lock shield. screenshot.js
+            // closes its overlay on sessionMode 'updated' the same way.
+            try {
+                this._lockedChangedId = Main.screenShield?.connect(
+                    'locked-changed', () => {
+                        try {
+                            this._onLockOrModeChange();
+                        } catch (e) {
+                            console.warn(`textSelect: locked-changed handler threw: ${e}`);
+                        }
+                    }) ?? 0;
+            } catch (e) {
+                console.warn(`textSelect: connect locked-changed failed: ${e}`);
+            }
+            try {
+                this._sessionUpdatedId = Main.sessionMode?.connect(
+                    'updated', () => {
+                        try {
+                            this._onLockOrModeChange();
+                        } catch (e) {
+                            console.warn(`textSelect: sessionMode updated handler threw: ${e}`);
+                        }
+                    }) ?? 0;
+            } catch (e) {
+                console.warn(`textSelect: connect sessionMode updated failed: ${e}`);
+            }
+        } catch (e) {
+            console.warn(`textSelect: enable() failed, disabling: ${e}`);
+            try {
+                this.disable();
+            } catch (e2) {
+                console.warn(`textSelect: disable() after enable failure threw: ${e2}`);
+            }
+        }
+    }
+
+    disable() {
+        // fajita: tear everything down, guarding each step independently so one
+        // failure can't strand the rest.
+        this._enabled = false;
+        this._generation++;   // fajita: F2 — invalidate any in-flight continuation
+
+        try {
+            if (this._gesture) {
+                try {
+                    if (this._recognizeId) {
+                        this._gesture.disconnect(this._recognizeId);
+                        this._recognizeId = 0;
+                    }
+                } catch (e) {
+                    console.warn(`textSelect: disconnect recognize failed: ${e}`);
+                }
+                try {
+                    if (this._mayRecognizeId) {
+                        this._gesture.disconnect(this._mayRecognizeId);
+                        this._mayRecognizeId = 0;
+                    }
+                } catch (e) {
+                    console.warn(`textSelect: disconnect may-recognize failed: ${e}`);
+                }
+                try {
+                    global.stage.remove_action(this._gesture);
+                } catch (e) {
+                    console.warn(`textSelect: remove_action failed: ${e}`);
+                }
+                this._gesture = null;
+            }
+        } catch (e) {
+            console.warn(`textSelect: disable() gesture teardown threw: ${e}`);
+        }
+
+        // fajita: F3 — disconnect the lock/session watchers.
+        try {
+            if (this._lockedChangedId) {
+                Main.screenShield?.disconnect(this._lockedChangedId);
+                this._lockedChangedId = 0;
+            }
+        } catch (e) {
+            console.warn(`textSelect: disconnect locked-changed failed: ${e}`);
+        }
+        try {
+            if (this._sessionUpdatedId) {
+                Main.sessionMode?.disconnect(this._sessionUpdatedId);
+                this._sessionUpdatedId = 0;
+            }
+        } catch (e) {
+            console.warn(`textSelect: disconnect sessionMode updated failed: ${e}`);
+        }
+
+        // fajita: F2 — clear the loading-phase watchdog.
+        this._clearLoadingWatchdog();
+
+        try {
+            this._teardownOverlay();
+        } catch (e) {
+            console.warn(`textSelect: teardown overlay in disable failed: ${e}`);
+        }
+
+        try {
+            this._cancellable?.cancel();
+        } catch (e) {
+            console.warn(`textSelect: cancelling in-flight subprocess failed: ${e}`);
+        }
+        this._cancellable = null;
+
+        try {
+            if (this._timeoutId) {
+                GLib.source_remove(this._timeoutId);
+                this._timeoutId = 0;
+            }
+        } catch (e) {
+            console.warn(`textSelect: clearing timeout in disable failed: ${e}`);
+        }
+
+        try {
+            this._inflightProc?.force_exit?.();
+        } catch (e) {
+            // ignore
+        }
+        this._inflightProc = null;
+
+        try {
+            if (this._dismissTimeoutId) {
+                GLib.source_remove(this._dismissTimeoutId);
+                this._dismissTimeoutId = 0;
+            }
+        } catch (e) {
+            // ignore
+        }
+
+        try {
+            if (this._noWordsTimeoutId) {
+                GLib.source_remove(this._noWordsTimeoutId);
+                this._noWordsTimeoutId = 0;
+            }
+        } catch (e) {
+            // ignore
+        }
+    }
+
+    _onRecognize() {
+        // fajita: guarded; on any surprise, no-op.
+        try {
+            if (!this._enabled)
+                return;
+
+            // fajita: F3 — only ever fire in normal/overview desktop mode. This
+            // keeps us off the lock screen, unlock dialog, and system-modal
+            // dialogs — we must never screenshot/OCR lock-screen content.
+            if (!(Main.actionMode &
+                    (Shell.ActionMode.NORMAL | Shell.ActionMode.OVERVIEW)))
+                return;
+
+            // A second long-press while an overlay is up just dismisses it.
+            if (this._overlayActors && this._overlayActors.length > 0) {
+                this._teardownOverlay();
+                return;
+            }
+
+            // fajita: F4 — a new recognize supersedes any in-flight helper. Cancel
+            // the previous resolve (kill its subprocess + watchdog) before we start
+            // a fresh one, so overlapping holds can't leak procs/timers.
+            this._cancelInflight();
+
+            // fajita: F2 — this recognize owns a fresh generation. Any async
+            // continuation captures `gen` and bails unless it still matches.
+            this._generation++;
+            const gen = this._generation;
+
+            let p = null;
+            try {
+                p = this._gesture.get_coords_abs();
+            } catch (e) {
+                console.warn(`textSelect: get_coords_abs failed: ${e}`);
+                return;
+            }
+            if (!p)
+                return;
+
+            const sx = p.x;
+            const sy = p.y;
+            if (typeof sx !== 'number' || typeof sy !== 'number')
+                return;
+
+            // Never fire while the overview/app-grid is showing.
+            try {
+                if (Main.overview?.visible)
+                    return;
+            } catch (e) {
+                console.warn(`textSelect: overview visibility check failed: ${e}`);
+            }
+
+            // fajita: F3/F7 — require a real app window UNDER the point. If the
+            // point isn't over any window frame, _windowAt returns null → no-op.
+            const win = this._windowAt(sx, sy);
+            if (!win)
+                return;
+
+            // Resolve app id from the best available accessor.
+            let gtkId = null;
+            let sandboxId = null;
+            let wmClass = null;
+            try {
+                gtkId = win.get_gtk_application_id?.() ?? null;
+            } catch (e) {
+                gtkId = null;
+            }
+            try {
+                sandboxId = win.get_sandboxed_app_id?.() ?? null;
+            } catch (e) {
+                sandboxId = null;
+            }
+            try {
+                wmClass = win.get_wm_class?.() ?? null;
+            } catch (e) {
+                wmClass = null;
+            }
+
+            // fajita: F9 — normalize to lowercase and match the blocklist
+            // case-insensitively; no-op cleanly for a shell/blocklisted window.
+            const appId = gtkId || sandboxId || wmClass || null;
+            if (appId && APP_ID_BLOCKLIST.has(String(appId).toLowerCase()))
+                return;
+            if (wmClass && APP_ID_BLOCKLIST.has(String(wmClass).toLowerCase()))
+                return;
+
+            // Frame rect origin for window-local coord conversion.
+            let frame = null;
+            try {
+                frame = win.get_frame_rect?.();
+            } catch (e) {
+                frame = null;
+            }
+            if (!frame)
+                return;
+
+            // fajita: route decision (F5/F9). Known browser/web/Waydroid ids are
+            // OCR-only; everything else falls through to OCR too (AT-SPI is
+            // bypassed for interactive selection — see below).
+            const isOcrOnly =
+                this._isOcrOnlyId(gtkId) ||
+                this._isOcrOnlyId(wmClass) ||
+                this._isOcrOnlyId(sandboxId);
+
+            this._dbg(`recognize appId=${appId ?? '(none)'} wmClass=${wmClass ?? '(none)'} isOcrOnly=${isOcrOnly}`);
+            // fajita: AT-SPI is intentionally bypassed for interactive selection.
+            // _resolveAtspi/_onAtspiResult remain in the file but are now dead.
+            this._dbg('atspi bypassed for interactive selection');
+
+            // fajita: F1 — do NOT freeze here. _resolveOcr captures the clean
+            // region screenshot FIRST, then raises the freeze (scrim+spinner+
+            // haptic) itself, so OCR never sees our own dimming scrim.
+            this._resolveOcr(sx, sy, gen);
+        } catch (e) {
+            console.warn(`textSelect: _onRecognize outer threw: ${e}`);
+            try {
+                this._teardownOverlay();
+            } catch (e2) {
+                console.warn(`textSelect: teardown after recognize failure threw: ${e2}`);
+            }
+        }
+    }
+
+    _showFreeze(sx, sy, gen) {
+        // fajita: synchronous instant-freeze on recognize (before OCR completes).
+        // NOTE: we deliberately do NOT call this._teardownOverlay() here — it
+        // bumps this._generation, which would desync the `gen` this call was
+        // given and make every subsequent async continuation bail. _onRecognize
+        // already early-returns when an overlay is present, so nothing should be
+        // up; we defensively clear stray actors inline WITHOUT bumping generation.
+        try {
+            if (!this._enabled || gen !== this._generation)
+                return;
+
+            // Defensive inline clear (no generation bump, no _dismissTimeoutId touch).
+            try {
+                const strayActors = this._overlayActors || [];
+                for (const a of strayActors) {
+                    try {
+                        a?.destroy();
+                    } catch (e) {
+                        // ignore
+                    }
+                }
+            } catch (e) {
+                // ignore
+            }
+            try {
+                const straySignals = this._overlaySignals || [];
+                for (const entry of straySignals) {
+                    try {
+                        const [actor, id] = entry;
+                        if (actor && id)
+                            actor.disconnect(id);
+                    } catch (e) {
+                        // ignore
+                    }
+                }
+            } catch (e) {
+                // ignore
+            }
+            this._overlayActors = [];
+            this._overlaySignals = [];
+            // fajita: F5 — reset dangling state too (no generation bump).
+            this._phase = null;
+            this._scrim = null;
+            this._startHandleCenter = null;
+            this._endHandleCenter = null;
+            this._dragging = null;
+
+            const monitor =
+                this._monitorForPoint(sx, sy) ??
+                Main.layoutManager?.primaryMonitor ?? null;
+            const mx = monitor ? monitor.x : 0;
+            const my = monitor ? monitor.y : 0;
+            const mw = monitor ? monitor.width : (global.stage?.width ?? 0);
+            const mh = monitor ? monitor.height : (global.stage?.height ?? 0);
+
+            const uiGroup = Main.layoutManager?.uiGroup;
+            if (!uiGroup)
+                return;
+
+            // Full-screen reactive scrim owns ALL input for the selection UI.
+            const scrim = new St.Widget({
+                reactive: true,
+                can_focus: true,
+                x: mx,
+                y: my,
+                width: mw,
+                height: mh,
+                style: 'background-color: rgba(0,0,0,0.35);',
+            });
+            uiGroup.add_child(scrim);
+            this._overlayActors.push(scrim);
+            this._scrim = scrim;
+
+            // Route ALL input through phase dispatchers. Each connect guarded.
+            try {
+                this._overlaySignals.push([
+                    scrim,
+                    scrim.connect('button-press-event', (_a, event) => this._onScrimButtonPress(event)),
+                ]);
+            } catch (e) {
+                console.warn(`textSelect: scrim button-press connect failed: ${e}`);
+            }
+            try {
+                this._overlaySignals.push([
+                    scrim,
+                    scrim.connect('motion-event', (_a, event) => this._onScrimMotion(event)),
+                ]);
+            } catch (e) {
+                console.warn(`textSelect: scrim motion connect failed: ${e}`);
+            }
+            try {
+                this._overlaySignals.push([
+                    scrim,
+                    scrim.connect('button-release-event', (_a, event) => this._onScrimButtonRelease(event)),
+                ]);
+            } catch (e) {
+                console.warn(`textSelect: scrim button-release connect failed: ${e}`);
+            }
+            try {
+                this._overlaySignals.push([
+                    scrim,
+                    scrim.connect('touch-event', (_a, event) => this._onScrimTouch(event)),
+                ]);
+            } catch (e) {
+                console.warn(`textSelect: scrim touch connect failed: ${e}`);
+            }
+            try {
+                this._overlaySignals.push([
+                    scrim,
+                    scrim.connect('key-press-event', (_a, event) => this._onScrimKey(event)),
+                ]);
+            } catch (e) {
+                console.warn(`textSelect: scrim key connect failed: ${e}`);
+            }
+
+            // "Selecting…" indicator, built DIRECTLY as an St.Label so
+            // this._loadingPill.text = '...' works later.
+            try {
+                const pill = new St.Label({
+                    text: 'Selecting…',
+                    style: 'background-color: rgba(40,40,40,0.95); color: white; ' +
+                        'border-radius: 14px; padding: 6px 12px;',
+                });
+                uiGroup.add_child(pill);
+                this._overlayActors.push(pill);
+                this._loadingPill = pill;
+
+                // Clamp near the touch point (same clamp math as _showOverlay).
+                let px = Number.isFinite(sx) ? sx : mx + mw / 2;
+                let py = Number.isFinite(sy) ? sy : my + mh / 2;
+                let pw = 0;
+                let ph = 0;
+                try {
+                    const [, natW] = pill.get_preferred_width(-1);
+                    const [, natH] = pill.get_preferred_height(-1);
+                    pw = natW || 0;
+                    ph = natH || 0;
+                } catch (e) {
+                    pw = 120;
+                    ph = 32;
+                }
+                if (px + pw > mx + mw)
+                    px = mx + mw - pw - 8;
+                if (px < mx + 8)
