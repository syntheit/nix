+/**
+ * Launch an application from Quick Settings and focus the window it owns.
+ *
+ * Phone home is itself the overview. Hiding it before a cold launch lets the
+ * zero-window fallback reopen the app grid before the new window maps. Watch
+ * the canonical app instead, and let Main.activateWindow() hide the overview
+ * only once there is a real window to focus.
+ *
+ * @param {string} desktopFile launcher desktop id
+ * @param {string=} focusDesktopFile desktop id that owns the resulting window
+ */
+export function launchApplication(desktopFile, focusDesktopFile = desktopFile) {
+    const appSystem = Shell.AppSystem.get_default();
+    const launchApp = appSystem.lookup_app(desktopFile);
+    const focusApp = appSystem.lookup_app(focusDesktopFile);
+
+    if (!launchApp) {
+        console.warn(`Application ${desktopFile} could not be loaded`);
+        return;
+    }
+
+    Main.panel.closeQuickSettings();
+
+    let windowsChangedId = 0;
+    let timeoutId = 0;
+
+    const cleanup = () => {
+        if (windowsChangedId) {
+            focusApp?.disconnect(windowsChangedId);
+            windowsChangedId = 0;
+        }
+        if (timeoutId) {
+            GLib.source_remove(timeoutId);
+            timeoutId = 0;
+        }
+    };
+
+    const focusWindow = () => {
+        const window = focusApp?.get_windows()
+            .find(candidate => !candidate.skip_taskbar);
+        if (!window)
+            return false;
+
+        cleanup();
+        Main.activateWindow(window);
+        return true;
+    };
+
+    if (focusApp)
+        windowsChangedId = focusApp.connect('windows-changed', focusWindow);
+
+    timeoutId = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 5000, () => {
+        timeoutId = 0;
+        cleanup();
+        return GLib.SOURCE_REMOVE;
+    });
+
+    launchApp.activate();
+    focusWindow();
+}
